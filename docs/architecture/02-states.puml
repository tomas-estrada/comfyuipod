@startuml 02-states

' ============================================================================
' 02 — Vista de comportamiento: ciclo de vida
' Rama: docs/maad-architecture-2026-11-10 · Base: main b7f21de
'
' Regla de legibilidad: los estados llevan SOLO su nombre; la evidencia
' (archivo:línea + confianza) vive en el legend, que PlantUML renderiza como
' bloque aparte y por tanto no se solapa con los nodos ni con las flechas.
'
' NO usar `!pragma teoz true` (es de diagramas de secuencia). `wrapWidth` debe
' ser pequeño: con 200 las etiquetas ocupaban media pantalla y el diagrama
' medía 4096x2270.
' ============================================================================

skinparam wrapWidth 60
skinparam nodesep 25
skinparam ranksep 35
skinparam padding 5
skinparam shadowing false
skinparam defaultTextAlignment center

title ComfyUIPod — ciclo de vida (pod, ComfyUI, producción, shot, motores)

' ---------------------------------------------------------------------------
' 1. Arranque del pod — fases ejecutadas de start.sh
' ---------------------------------------------------------------------------
[*] --> Fase1_ffmpeg

Fase1_ffmpeg : [1/7]\nverificar ffmpeg
Fase2b_volumen : [1b/7]\nesperar volumen
Fase2_datos : [2/7]\npreparar datos
Fase3_auth : [3/7]\nhtpasswd
Fase4_nginx : [4/7]\nNginx + ttyd
Fase5_supervise : [5/7]\nexec supervise

Fase1_ffmpeg --> Fase2b_volumen : "bajo /workspace"
Fase2b_volumen --> Fase2_datos : "montaje OK"
Fase2b_volumen --> Fase2_datos : "timeout: avisa"
Fase2_datos --> Fase3_auth
Fase3_auth --> Fase4_nginx : "htpasswd OK"
Fase3_auth --> Abortado : "falla → exit 1"
Fase4_nginx --> Fase5_supervise
Fase5_supervise --> StrictCheck

' ---------------------------------------------------------------------------
' 2. strict-check — la puerta de seguridad
' ---------------------------------------------------------------------------
StrictCheck : strict-check\nS1..S17
Sirviendo : pod sirviendo
Gracia : gracia fatal
Terminado_20 : exit 20
Abortado : abortado

StrictCheck --> Sirviendo : "ok"
StrictCheck --> Gracia : "fatal + STRICT_START=1"
Gracia --> Terminado_20
Sirviendo --> [*]
Terminado_20 --> [*]
Abortado --> [*]

' ---------------------------------------------------------------------------
' 3. ComfyUI supervisado
' ---------------------------------------------------------------------------
state "ComfyUI" as ComfyUILife #FFF2CC {
    [*] --> CUI_Iniciando
    CUI_Iniciando : starting
    CUI_Corriendo : running
    CUI_Caido : caído

    CUI_Iniciando --> CUI_Corriendo : "puerto abierto"
    CUI_Corriendo --> CUI_Caido : "muere"
    CUI_Caido --> CUI_Iniciando : "reinicio acotado"
    CUI_Caido --> [*] : "max agotado"
}

' ---------------------------------------------------------------------------
' 4. Producción — gate de gasto humano
' ---------------------------------------------------------------------------
state "Producción" as ProdLife #CFE2F3 {
    left to right direction
    [*] --> P_Awaiting
    P_Awaiting : awaiting_approval
    P_Executing : executing
    P_Done : done
    P_Simulated : simulated
    P_Failed : failed
    P_Cancelled : cancelled
    P_Halted : halted

    P_Awaiting --> P_Executing : "POST /approve"
    P_Awaiting --> P_Cancelled : "POST /cancel"
    P_Awaiting --> P_Awaiting : "PATCH /plan"

    P_Executing --> P_Done : "reel listo"
    P_Executing --> P_Simulated : "sin cablear"
    P_Executing --> P_Failed : "fallo de capa"
    P_Executing --> P_Cancelled : "cancelación"
    P_Executing --> P_Halted : "halted"

    P_Done --> [*]
    P_Simulated --> [*]
    P_Failed --> [*]
    P_Cancelled --> [*]
    P_Halted --> [*]
}

note top of P_Awaiting
  Gate de gasto humano: el lazo caro no corre
  hasta que una persona aprueba. El agente
  LLM nunca ve `approve`.
end note

' ---------------------------------------------------------------------------
' 5. Shot
' ---------------------------------------------------------------------------
state "Shot" as ShotLife #FCE5CD {
    [*] --> S_Planned
    S_Planned : planned
    S_Running : running
    S_Evaluating : evaluating
    S_Accepted : accepted
    S_Replanning : replanning
    S_Failed : failed

    S_Planned --> S_Running : "ejecuta capas"
    S_Running --> S_Evaluating : "capas listas"
    S_Evaluating --> S_Accepted : "pasa acceptance"
    S_Evaluating --> S_Replanning : "no pasa"
    S_Replanning --> S_Running : "reintenta"
    S_Replanning --> S_Failed : "escalones agotados"
    S_Accepted --> [*]
    S_Failed --> [*]
}

' ---------------------------------------------------------------------------
' 6. Motor
' ---------------------------------------------------------------------------
state "Motor" as EngineLife #D9EAD3 {
    [*] --> E_Estado
    E_Estado : estado
    E_Ready : ready
    E_Stub : stub
    E_Unwired : unwired

    E_Estado --> E_Ready : "cableado"
    E_Estado --> E_Stub : "STUDIO_STUB_*"
    E_Estado --> E_Unwired : "sin cablear"
}

note bottom of EngineLife
  assert_production_ready exige 'ready';
  'stub' y 'unwired' lanzan EngineNotReadyError.
end note

legend right
  **Evidencia** — todas las transiciones: confirmado
  |= transición |= archivo:línea |
  | Fase1 → Fase1b | scripts/start.sh:92 |
  | Fase1b → Fase2 | scripts/start.sh:147 |
  | montaje OK / timeout | scripts/start.sh:154 / :160 |
  | Fase2 → Fase3 | scripts/start.sh:176 |
  | htpasswd OK | scripts/start.sh:366 |
  | falla → exit 1 | scripts/start.sh:367 |
  | Fase4 | scripts/start.sh:377 |
  | Fase5 (exec) | scripts/start.sh:397 |
  | strict → ok | comfyctl/src/strict.rs:1560 |
  | fatal → gracia | comfyctl/src/supervisor.rs:937 |
  | gracia → exit 20 | comfyctl/src/strict.rs:1568 |
  | ComfyUI starting/running | comfyctl/src/collect/procfs.rs:354 / :350 |
  | reinicio acotado | comfyctl/src/supervisor.rs:1 |
  | max agotado | _(hueco: umbral no leído)_ |
  | awaiting_approval | studio/comfy_studio/orchestration/service.py:186 |
  | executing | studio/comfy_studio/orchestration/service.py:333 |
  | PATCH /plan | studio/comfy_studio/orchestration/service.py:249 |
  | cancel | studio/comfy_studio/orchestration/service.py:307 |
  | fases terminales | studio/comfy_studio/orchestration/service.py:56 |
  | simulado | studio/comfy_studio/orchestration/service.py:165 |
  | shot: estados | studio/comfy_studio/orchestration/state.py:33 |
  | escalones agotados | _(hueco: límite no leído)_ |
  | motor ready/stub/unwired | studio/comfy_studio/engines/health.py:67 |
