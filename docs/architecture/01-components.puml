@startuml 01-components

' ============================================================================
' 01 — Vista estática de componentes (ComfyUIPod)
' Rama: docs/maad-architecture-2026-11-10 · Base: main b7f21de
'
' Regla de legibilidad: las etiquetas del grafo llevan SOLO el nombre funcional
' de la arista. La evidencia (archivo:línea + confianza) vive en el legend de
' abajo, que PlantUML renderiza como bloque aparte y por tanto no se solapa con
' los nodos ni con las flechas.
'
' NO usar `!pragma teoz true` (es de diagramas de secuencia) ni
' `skinparam linetype ortho` (provoca cruces y solapes): ambas cosas hacían
' ilegible la versión anterior de este diagrama.
' ============================================================================

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 150
skinparam nodesep 30
skinparam ranksep 45
skinparam padding 6
skinparam shadowing false

title ComfyUIPod — vista estática de componentes

actor "Operario" as op

package "Host / Vast.ai pod" {

    node "Contenedor (Ubuntu 24.04)" as container {

        rectangle "Nginx\n:8188 público" as nginx #FFD9A0 {
            rectangle "auth_basic" as basicauth
            rectangle "HSTS + CSP" as hdrs
            rectangle "rate limiting" as rl
        }

        package "comfyctl (Rust)" as comfyctl #D9EAD3 {
            rectangle "supervise\nprocesos" as supervise
            rectangle "HTTP :18189" as ctlhttp
            rectangle "strict-check\nS1..S17" as strict
            rectangle "report / diag" as report
            rectangle "collect" as collect
            rectangle "redact" as redact
            rectangle "logtail" as logtail
        }

        package "studio-server (FastAPI)" as studio #CFE2F3 {
            rectangle "routers\n/studio/api/*" as routers
            rectangle "middleware\nauth + redacción" as mw
            rectangle "orchestration" as orch
            rectangle "engines" as engines
            rectangle "agent" as agent
            rectangle "asset_acquire" as acquire
            rectangle "perception" as percep
        }

        rectangle "ComfyUI\n:18188" as comfyui #FCE5CD
        rectangle "ttyd\n:7681" as ttyd #EAD1DC

        rectangle "COMFY_DATA_DIR\n/workspace/comfyui-data" as volume #FFF2CC
        rectangle "COMFY_APP_DIR\n/opt/ComfyUI" as appdir #F3F3F3

        rectangle "start.sh\n7 fases" as startsh
        rectangle "download-models.sh" as dlmodels
    }
}

cloud "Proveedor LLM" as llm #E6E0EC

' --- aristas: etiqueta corta, evidencia en el legend ---
op --> nginx :        "HTTPS :8188"
nginx --> supervise : "/status /report.md"
nginx --> ctlhttp :   "/status/api /diag /logs"
nginx --> studio :    "/studio/"
nginx --> ttyd :      "/terminal/"
nginx --> comfyui :   "/ y /ws"

supervise --> comfyui :  "lanza y reinicia"
supervise --> studio :   "lanza y espera sano"
supervise --> dlmodels : "bootstrap 600 s"
supervise --> logtail :  "trunca logs"

ctlhttp --> report :  "/report.md"
ctlhttp --> collect : "/status/api"
ctlhttp --> redact :  "redacta"
ctlhttp --> logtail : "/logs/*"

strict --> collect : "lee GPU/RAM/disco"
mw --> redact :      "redacta cuerpo"

routers --> orch :    "plan / approve"
routers --> engines : "ejecuta capas"
orch --> engines :    "run_layer + lease"
orch --> agent :      "planner + evaluación"
agent --> llm :       "chat / visión"

engines --> comfyui : "prompt + historial"
percep --> volume :   "índice vectorial"
acquire --> volume :  "descarga modelos"
dlmodels --> acquire : "delega en el CLI"

startsh --> dlmodels : "fase 2"
startsh --> nginx :    "fase 4"
startsh --> supervise : "fase 5 (exec)"

comfyui --> volume : "modelos y salidas"
comfyui --> appdir : "código inmutable"
volume --> appdir :  "symlinks"

note right of nginx
  Único punto de entrada público.
  Todo lo demás escucha en 127.0.0.1.
end note

note bottom of volume
  Contrato núcleo: nada de datos vive en /opt/ComfyUI.
  Los symlinks apuntan al volumen, así que modelos y
  salidas sobreviven al reinicio del pod.
end note

note left of strict
  Si una comprobación fatal falla con STRICT_START=1,
  el contenedor termina con código 20.
end note

legend right
