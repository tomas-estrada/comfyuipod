{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "buffer": "20%",
    "keep": {
      "tokens": 12000
    }
  },
  "agents": {
    "build": {
      "steps": 12,
      "permissions": [
        {"action": "subagent", "resource": "*", "effect": "deny"},
        {"action": "subagent", "resource": "harnessed-builder", "effect": "allow"}
      ]
    },
    "free-builder": {
      "steps": 12,
      "permissions": [
        {"action": "subagent", "resource": "*", "effect": "deny"},
        {"action": "subagent", "resource": "harnessed-builder", "effect": "allow"}
      ]
    },
    "harnessed-builder": {
      "mode": "subagent",
      "steps": 12,
      "permissions": [
        {"action": "subagent", "resource": "*", "effect": "deny"}
      ]
    },
    "compaction": {
      "model": "ollama/qwen3.5:2b-opencode64k"
    }
  },
  "providers": {
    "ollama": {
      "models": {
        "qwen3.5:2b-opencode64k": {
          "name": "Qwen3.5 2B local compaction",
          "limit": {
            "context": 65536,
            "output": 2048
          },
          "settings": {
            "reasoningEffort": "none"
          }
        }
      }
    }
  }
}
