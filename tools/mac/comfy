#!/usr/bin/env bash
# ==============================================================================
# comfy — CLI helper para macOS / Linux para gestionar instancias ComfyUIPod en Vast.ai
# ==============================================================================
# Subcomandos (§10.1):
#   comfy [open] [id] [home|comfy|status|report|terminal|studio]
#   comfy studio [id]
#   comfy studio report [id] [--stdout]
#   comfy url [id]
#   comfy all
#   comfy logs [id] [N]
#   comfy pass [id]
#   comfy report [id] [--stdout]
#   comfy watch [id]
#   comfy rent [all|general|realistic|anime|minimal|studio] [--dry-run] [--yes]
#   comfy destroy <id>
# ==============================================================================

set -euo pipefail

# VAL-SERVER-005 / VAL-CROSS-004: Desactivar historial del shell en este proceso
# para evitar cualquier persistencia accidental de credenciales o llaves leídas.
HISTFILE=/dev/null
unset HISTFILE
set +o history 2>/dev/null || true

COMFY_IMAGE="${COMFY_IMAGE:-}"
COMFY_USER="${COMFY_USER:-admin}"
PYTHON_BIN="${COMFY_PYTHON:-python3}"

die() {
    echo "[ERROR] $*" >&2
    exit 1
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "Comando requerido no encontrado: '$1'. Instálalo antes de continuar."
}

# V27: Rechazar saltos de línea en la contraseña: un \n o \r inyectaría líneas
# de configuración extra en el config de stdin de curl (-K -) y rompería --env.
check_pass_safe() {
    case "$1" in
        *$'\n'*|*$'\r'*)
            die "La contraseña contiene saltos de línea (\\n o \\r); no es válida. Eliminalos de COMFY_PASS."
            ;;
    esac
}

# Validar que un secreto reenviado en --env no contenga saltos de línea ni comillas dobles
# que puedan romper el parseo de flags `-e KEY="VALUE"` en vastai create instance.
check_secret_safe() {
    local secret_val="$1"
    local secret_name="${2:-secreto}"
    case "${secret_val}" in
        *$'\n'*|*$'\r'*|*$'"'*)
            die "El valor de ${secret_name} contiene saltos de línea o comillas dobles no válidas."
            ;;
    esac
}

# O-13: Pasar credenciales por stdin a curl (-K -) para no exponerlas en ps aux
curl_auth() {
    require_cmd curl
    local user="$1"
    local pass="$2"
    shift 2
    check_pass_safe "${pass}"
    local escaped_pass="${pass//\\/\\\\}"
    escaped_pass="${escaped_pass//\"/\\\"}"
    printf 'user = "%s:%s"\n' "${user}" "${escaped_pass}" | curl -K - "$@"
}

# O-14: Respetar COMFY_BROWSER y distinguir Darwin (macOS) vs Linux
open_browser() {
    local target_url="$1"
    if [ -n "${COMFY_BROWSER:-}" ]; then
        "${COMFY_BROWSER}" "${target_url}"
    elif [ "$(uname -s)" = "Darwin" ] && command -v open >/dev/null 2>&1; then
        /usr/bin/open "${target_url}"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "${target_url}"
    else
        echo "${target_url}"
    fi
}

# Obtiene JSON crudo de vastai show instances --raw
fetch_instances_json() {
    require_cmd vastai
    require_cmd "${PYTHON_BIN}"
    vastai show instances --raw
}

# Resuelve ID, IP y HostPort (8188/tcp) de una instancia activa.
# Salida: "<id>|<ip>|<port>|<status>|<label>"
resolve_instance() {
    local requested_id="${1:-}"
    local allow_starting="${2:-0}"
    local raw_json
    raw_json="$(fetch_instances_json)"

    RAW_JSON="${raw_json}" "${PYTHON_BIN}" - "${requested_id}" "${allow_starting}" << 'PYEOF'
import json, os, sys

req_id = sys.argv[1].strip()
allow_starting = sys.argv[2].strip() == "1"
raw = os.environ.get("RAW_JSON", "")
try:
    parsed = json.loads(raw)
except Exception as e:
    sys.stderr.write(f"[ERROR] No se pudo parsear 'vastai show instances --raw': {e}\n")
    sys.exit(1)

if isinstance(parsed, dict):
    instances = parsed.get("instances") or parsed.get("rows") or []
elif isinstance(parsed, list):
    instances = parsed
else:
    instances = []

def extract_port(inst):
    ports = inst.get("ports") or {}
    tcp_8188 = ports.get("8188/tcp")
    if isinstance(tcp_8188, list) and tcp_8188:
        hp = tcp_8188[0].get("HostPort") or tcp_8188[0].get("host_port")
        if hp:
            return str(hp)
    # Solo para instancias legadas creadas con --direct (runtype jupyter/ssh);
    # las instancias nuevas (runtype args) siempre usan el mapeo proxy de ports.
    direct_start = inst.get("direct_port_start")
    if direct_start and int(direct_start) > 0:
        return str(direct_start)
    return ""

candidates = []
for inst in instances:
    iid = str(inst.get("id", ""))
    status = str(inst.get("actual_status") or inst.get("status_msg") or "unknown")
    ip = str(inst.get("public_ipaddr") or "").strip()
    port = extract_port(inst)
    label = str(inst.get("label") or "")
    if req_id:
        if iid == req_id:
            candidates.append((0, iid, ip, port, status, label))
            break
    else:
        if (status == "running" and ip and port) or (allow_starting and status in ("running", "loading", "creating", "starting")):
            prio = 0 if label.lower().startswith("comfy") else 1
            if status != "running":
                prio += 2
            candidates.append((prio, iid, ip, port, status, label))

if not candidates:
    if req_id:
        sys.stderr.write(f"[ERROR] No se encontró la instancia con ID {req_id}.\n")
    else:
        sys.stderr.write("[ERROR] No se encontró ninguna instancia activa con puerto 8188/tcp mapeado.\n")
    sys.exit(1)

candidates.sort(key=lambda x: x[0])
_, iid, ip, port, status, label = candidates[0]
print(f"{iid}|{ip}|{port}|{status}|{label}")
PYEOF
}

fetch_logs_text() {
    local inst_id="$1"
    local tail_n="${2:-300}"
    require_cmd vastai
    require_cmd curl
    local out
    out="$(vastai logs "${inst_id}" --tail "${tail_n}" 2>&1 || true)"
    # Compatibilidad con versiones antiguas de vastai CLI que devolvían una URL S3
    if [[ "${out}" =~ ^https?:// ]]; then
        curl -fsSL "${out}" 2>/dev/null || printf '%s\n' "${out}"
    else
        local s3_url
        s3_url="$(printf '%s\n' "${out}" | grep -Eo 'https://[^[:space:]"'\'']+' | tail -n 1 || true)"
        if [ -n "${s3_url}" ] && [ "$(printf '%s\n' "${out}" | wc -l)" -le 3 ]; then
            curl -fsSL "${s3_url}" 2>/dev/null || printf '%s\n' "${out}"
        else
            printf '%s\n' "${out}"
        fi
    fi
}

cmd_all() {
    local raw_json
    raw_json="$(fetch_instances_json)"
    RAW_JSON="${raw_json}" "${PYTHON_BIN}" - << 'PYEOF'
import json, os, sys

raw = os.environ.get("RAW_JSON", "")
parsed = json.loads(raw)
instances = parsed.get("instances", []) if isinstance(parsed, dict) else parsed

if not instances:
    print("No hay instancias activas en tu cuenta de Vast.ai.")
    sys.exit(0)

header = f"{'ID':<10} {'ESTADO':<10} {'GPU':<18} {'$/h':<7} {'LABEL':<18} {'PORTAL (/home)':<36} {'STATUS (/status)'}"
print(header)
print("-" * len(header))
for inst in instances:
    iid = str(inst.get("id", ""))
    status = str(inst.get("actual_status") or "unknown")
    gpu = str(inst.get("gpu_name") or "?")[:17]
    dph = float(inst.get("dph_total") or 0.0)
    label = str(inst.get("label") or "-")[:17]
    ip = str(inst.get("public_ipaddr") or "").strip()
    ports = inst.get("ports") or {}
    tcp = ports.get("8188/tcp") or []
    port = str(tcp[0].get("HostPort", "")) if tcp else ""
    base = f"http://{ip}:{port}" if (ip and port) else "(sin puerto público)"
    home_url = f"{base}/home" if ip and port else base
    stat_url = f"{base}/status" if ip and port else "-"
    print(f"{iid:<10} {status:<10} {gpu:<18} {dph:<7.3f} {label:<18} {home_url:<36} {stat_url}")
PYEOF
}

cmd_url() {
    local inst_id="${1:-}"
    local info ip port
    info="$(resolve_instance "${inst_id}")"
    IFS='|' read -r _ ip port _ _ <<<"${info}"
    if [ -z "${ip}" ] || [ -z "${port}" ]; then
        die "La instancia aún no expone IP/puerto público."
    fi
    echo "http://${ip}:${port}"
}

cmd_open() {
    local arg1="${1:-}"
    local arg2="${2:-}"
    local inst_id=""
    local target_view="home"

    case "${arg1}" in
        home|comfy|status|report|terminal|studio|"")
            target_view="${arg1:-home}"
            ;;
        *)
            inst_id="${arg1}"
            target_view="${arg2:-home}"
            ;;
    esac

    local path_suffix
    case "${target_view}" in
        home)     path_suffix="/home" ;;
        comfy)    path_suffix="/" ;;
        status)   path_suffix="/status" ;;
        report)   path_suffix="/report.md" ;;
        terminal) path_suffix="/terminal/" ;;
        studio)   path_suffix="/studio/" ;;
        *)        die "Vista no reconocida: '${target_view}'. Usa: home | comfy | status | report | terminal | studio" ;;
    esac

    # O-14: Esperar hasta 10 min (200 * 3s) si la instancia sigue arrancando o Nginx aún no responde
    require_cmd curl
    local wait_timeout="${COMFY_OPEN_TIMEOUT:-600}"
    local deadline=$((SECONDS + wait_timeout))
    local resolved_id="" ip="" port="" status=""
    local healthz_ok="0"
    local portal_ok="0"
    local resolve_err_file="/tmp/comfy-resolve-err.$$"
    while [ "${SECONDS}" -lt "${deadline}" ]; do
        local info=""
        if info="$(resolve_instance "${inst_id}" "1" 2>"${resolve_err_file}")"; then
            IFS='|' read -r resolved_id ip port status _ <<<"${info}"
            if [ "${status}" = "exited" ] || [ "${status}" = "stopped" ]; then
                rm -f "${resolve_err_file}"
                echo "[FATAL] La instancia ${resolved_id} pasó a estado '${status}' (probable fallo de arranque estricto STRICT_START=1 / código 20)." >&2
                echo "        Ejecuta 'comfy logs ${resolved_id}' para ver el motivo y 'comfy destroy ${resolved_id}' para detener el cobro de disco." >&2
                return 1
            fi
            if [ "${status}" = "running" ] && [ -n "${ip}" ] && [ -n "${port}" ]; then
                # -I (HEAD): /healthz responde sin cuerpo (proxy_method HEAD); un GET colgaria
                # hasta --max-time pese al 200 real y nunca romperia el bucle de espera.
                if curl -fsSI --max-time 3 "http://${ip}:${port}/healthz" >/dev/null 2>&1; then
                    healthz_ok="1"
                    break
                fi
                # R-10: Si /healthz devuelve 502 (Fase 1 en curso o ventana de gracia de strict FATAL),
                # comprobar si Nginx ya responde en /home (200/401) y consultar /status/api si hay credenciales.
                local home_code
                home_code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "http://${ip}:${port}/home" 2>/dev/null || echo "000")"
                if [ "${home_code}" = "200" ] || [ "${home_code}" = "401" ]; then
                    local probe_pass="${COMFY_PASS:-}"
                    if [ -z "${probe_pass}" ]; then
                        probe_pass="$(cmd_pass "${resolved_id}" 2>/dev/null || true)"
                    fi
                    if [ -n "${probe_pass}" ]; then
                        local api_json
                        api_json="$(curl_auth "${COMFY_USER}" "${probe_pass}" -fsSL --max-time 3 "http://${ip}:${port}/status/api" 2>/dev/null || true)"
                        if [ -n "${api_json}" ]; then
                            if API_JSON="${api_json}" "${PYTHON_BIN}" -c 'import json, os, sys; sys.exit(0 if (json.loads(os.environ["API_JSON"]).get("strict") or {}).get("result") == "fatal" else 1)' 2>/dev/null; then
                                rm -f "${resolve_err_file}"
                                echo "[FATAL] La instancia ${resolved_id} falló el arranque estricto (strict.result=fatal):" >&2
                                API_JSON="${api_json}" "${PYTHON_BIN}" - << 'PYEOF'
import json, os, sys
st = json.loads(os.environ["API_JSON"]).get("strict") or {}
for c in st.get("checks") or []:
    if c.get("status") == "fatal":
        cid = c.get("id")
        cname = c.get("name")
        cdetail = c.get("detail")
        crem = c.get("remediation")
        print(f"  * {cid} ({cname}): {cdetail}", file=sys.stderr)
        if crem:
            print(f"    Remediación: {crem}", file=sys.stderr)
PYEOF
                                echo "Abriendo http://${ip}:${port}/home para inspección y abortando espera..." >&2
                                open_browser "http://${ip}:${port}/home"
                                return 20
                            fi
                        fi
                    fi
                    if [ "${target_view}" != "comfy" ]; then
                        portal_ok="1"
                        break
                    fi
                fi
            fi
            echo "[INFO] Instancia ${resolved_id} en estado '${status}' (${ip:-sin-ip}:${port:-sin-puerto}); esperando a que Nginx responda..." >&2
        else
            # V27: solo ocultar el stderr esperado de "aún no aparece"; otros errores
            # (API key caducada, fallo de red, JSON inválido) se muestran en vez de
            # hacer esperar 10 min en silencio.
            local resolve_err=""
            resolve_err="$(cat "${resolve_err_file}" 2>/dev/null || true)"
            case "${resolve_err}" in
                ""|*"No se encontró"*)
                    echo "[INFO] Esperando a que la instancia aparezca en Vast.ai..." >&2
                    ;;
                *)
                    rm -f "${resolve_err_file}"
                    die "Error al resolver la instancia en Vast.ai: ${resolve_err}"
                    ;;
            esac
        fi
        sleep 3
    done
    rm -f "${resolve_err_file}"

    if [ -z "${ip}" ] || [ -z "${port}" ]; then
        die "Timeout esperando IP/puerto público de la instancia."
    fi

    if [ "${healthz_ok}" != "1" ] && [ "${portal_ok}" != "1" ]; then
        # No die: el portal puede seguir levantándose; Nginx mostrará su página
        # de auto-refresco /_starting.html o aún no responderá.
        echo "[WARN] /healthz no respondió OK en el tiempo esperado; el portal puede no estar listo aún (página _starting.html o en blanco). Revisa 'comfy logs ${resolved_id}'." >&2
    fi

    local full_url="http://${ip}:${port}${path_suffix}"
    echo "Abriendo ${full_url} ..."
    open_browser "${full_url}"
}

cmd_logs() {
    local inst_id="${1:-}"
    local tail_n="${2:-300}"
    if [[ "${inst_id}" =~ ^[0-9]+$ ]] && [ -z "${2:-}" ]; then
        # Si solo se pasó un número, verificar si coincide con una instancia; si no, asumir tail_n
        local info
        if info="$(resolve_instance "${inst_id}" 2>/dev/null)"; then
            IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
        else
            tail_n="${inst_id}"
            info="$(resolve_instance "")"
            IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
        fi
    else
        local info
        info="$(resolve_instance "${inst_id}")"
        IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
    fi
    fetch_logs_text "${inst_id}" "${tail_n}"
}

cmd_pass() {
    local inst_id="${1:-}"
    local info
    info="$(resolve_instance "${inst_id}")"
    IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
    local logs_txt
    logs_txt="$(fetch_logs_text "${inst_id}" 500)"
    local auto_pass
    auto_pass="$(printf '%s\n' "${logs_txt}" | sed -n 's/.*Contraseña[[:space:]]*:[[:space:]]*\([a-fA-F0-9]\{16,\}\).*/\1/p' | tail -n 1)"
    if [ -n "${auto_pass}" ]; then
        echo "${auto_pass}"
    elif printf '%s\n' "${logs_txt}" | grep -q "definida por el usuario en COMFY_PASS"; then
        echo "[INFO] La instancia usa la contraseña definida manualmente por el usuario en COMFY_PASS." >&2
        return 1
    else
        echo "[WARN] Aún no se encontró la línea de credenciales en los logs de la instancia ${inst_id}." >&2
        return 1
    fi
}

resolve_auth_pass() {
    local inst_id="$1"
    if [ -n "${COMFY_PASS:-}" ]; then
        check_pass_safe "${COMFY_PASS}"
        echo "${COMFY_PASS}"
        return 0
    fi
    local detected
    if detected="$(cmd_pass "${inst_id}" 2>/dev/null)" && [ -n "${detected}" ]; then
        echo "${detected}"
        return 0
    fi
    read -r -s -p "Introduce COMFY_PASS para ${COMFY_USER}: " input_pass >&2 || die "Entrada cerrada (EOF)."
    echo "" >&2
    input_pass="${input_pass%$'\r'}"
    check_pass_safe "${input_pass}"
    echo "${input_pass}"
}

# VAL-SERVER-005 / VAL-CROSS-004: Redacción defensiva del informe en el cliente
# para garantizar que ni STUDIO_LLM_KEY, ni COMFY_PASS, ni HF_TOKEN ni tokens sk-*/hf_*/Bearer
# aparezcan jamás en claro, incluso si algún log upstream los incluyera accidentalmente.
redact_and_enrich_report() {
    local raw_md="$1"
    local studio_health_json="${2:-}"
    local studio_status_json="${3:-}"
    local status_api_json="${4:-}"
    local secret_pass="${5:-}"
    local secret_llm="${6:-}"
    local secret_hf="${7:-}"
    local secret_llm_fallback="${8:-}"

    RAW_MD="${raw_md}" \
    STUDIO_HEALTH_JSON="${studio_health_json}" \
    STUDIO_STATUS_JSON="${studio_status_json}" \
    STATUS_API_JSON="${status_api_json}" \
    _SECRET_PASS="${secret_pass}" \
    _SECRET_LLM="${secret_llm}" \
    _SECRET_HF="${secret_hf}" \
    _SECRET_LLM_FALLBACK="${secret_llm_fallback}" \
    "${PYTHON_BIN}" - << 'PYEOF'
import json, os, re

text = os.environ.get("RAW_MD", "")
health_raw = os.environ.get("STUDIO_HEALTH_JSON", "").strip()
status_raw = os.environ.get("STUDIO_STATUS_JSON", "").strip()
api_raw = os.environ.get("STATUS_API_JSON", "").strip()

def parse_json(raw_str):
    if not raw_str:
        return {}
    try:
        val = json.loads(raw_str)
        return val if isinstance(val, dict) else {}
    except Exception:
        return {}

health = parse_json(health_raw)
st = parse_json(status_raw)
api = parse_json(api_raw)

_safe_markers = (
    "<definida>",
    "<definido>",
    "<no definida>",
    "<no definido>",
    "<vacía>",
    "<autogenerada>",
    "<autogenerada — ver logs del contenedor>",
    "<definida por el usuario>",
    "[REDACTED]",
    "no definida",
    "no definido",
    "autogenerada",
)

if health or st:
    lines = ["", "## 11. Estado de Comfy Studio (`/studio/api`)", ""]
    srv_state = health.get("server") or st.get("status") or "desconocido"
    comfy_state = health.get("comfyui") or (st.get("comfyui") or {}).get("status") or "desconocido"
    comfy_reach = health.get("comfyui_reachable")
    if comfy_reach is None:
        comfy_reach = (st.get("comfyui") or {}).get("reachable")
    profile = health.get("model_profile") or (st.get("env_masked") or {}).get("MODEL_PROFILE") or "studio"
    llm = st.get("llm") or {}
    llm_model = health.get("llm_model") or llm.get("model") or "-"
    llm_fallback = llm.get("fallback_model") or "-"
    key_status = health.get("llm_key_status") or llm.get("key_status") or "<no definida>"
    if key_status not in ("<definida>", "<no definida>"):
        key_status = "<definida>"
    db = st.get("db") or {}
    disk = api.get("disk") or {}

    lines.append(f"- **Studio server**: `{srv_state}` · **ComfyUI**: `{comfy_state}` (reachable: `{comfy_reach}`)")
    lines.append(f"- **Perfil activo (`MODEL_PROFILE`)**: `{profile}`")
    lines.append(f"- **LLM**: modelo `{llm_model}` · fallback `{llm_fallback}` · `STUDIO_LLM_KEY`: `{key_status}`")
    if db:
        lines.append(
            f"- **SQLite Studio**: schema `v{db.get('schema_version', 1)}` · "
            f"`{db.get('projects_count', 0)}` proyecto(s) · `{db.get('jobs_count', 0)}` job(s)"
        )
    if disk:
        lines.append(
            f"- **Disco (`{disk.get('path', '/workspace/comfyui-data')}`)**: "
            f"`{disk.get('used_gb', 0)}` GB usados / `{disk.get('total_gb', 0)}` GB totales "
            f"(`{disk.get('free_gb', 0)}` GB libres)"
        )

    env_masked = dict(api.get("env_masked") or {})
    env_masked.update(st.get("env_masked") or {})
    if env_masked:
        lines.append("")
        lines.append("### Variables de entorno Studio (enmascaradas)")
        for k in sorted(env_masked.keys()):
            v = str(env_masked[k])
            if any(tok in k.upper() for tok in ("KEY", "PASS", "TOKEN", "SECRET", "AUTH")):
                if v and v not in _safe_markers:
                    v = "<definida>"
            lines.append(f"- `{k}` = `{v}`")
    lines.append("")
    text = text.rstrip() + "\n" + "\n".join(lines)

# Redacción defensiva de cualquier valor sensible conocido en memoria o por patrón
for env_name in ("_SECRET_PASS", "_SECRET_LLM", "_SECRET_HF", "_SECRET_LLM_FALLBACK"):
    secret_val = os.environ.get(env_name, "")
    if secret_val and len(secret_val) >= 4:
        text = text.replace(secret_val, "<definida>")

# Enmascarar asignaciones explícitas a variables sensibles en Markdown o logs,
# preservando íntegros los marcadores multi-palabra (<no definida>, <definida por el usuario>, etc.)
secret_var_re = re.compile(
    r"((?:`?(?:STUDIO_LLM_KEY|STUDIO_LLM_FALLBACK_KEY|COMFY_PASS|HF_TOKEN|OPENAI_API_KEY|DASHSCOPE_API_KEY|DEEPSEEK_API_KEY|VAST_API_KEY)`?)\s*(?:=|:)\s*`?)"
    r"(<[^><\n\r]{1,64}>|\[REDACTED\]|no definida|no definido|autogenerada|[^`\s\n\r\"']+)"
    r"(`?)"
)
def _mask_var(match):
    prefix, val, suffix = match.group(1), match.group(2), match.group(3)
    if val in _safe_markers:
        return match.group(0)
    return f"{prefix}<definida>{suffix}"

text = secret_var_re.sub(_mask_var, text)

# Patrones de tokens y cabeceras de autorización
text = re.sub(r"\bsk-[A-Za-z0-9_-]{8,}\b", "[REDACTED]", text)
text = re.sub(r"\bhf_[A-Za-z0-9]{8,}\b", "[REDACTED]", text)
text = re.sub(r"(?i)(authorization\s*:\s*(?:bearer|basic)\s+)[^\s\"'`]+", r"\1[REDACTED]", text)
text = re.sub(r"(?i)\b(bearer\s+)[A-Za-z0-9._\-]{8,}", r"\1[REDACTED]", text)
text = re.sub(r"https?://[^/\s:@]+:[^/\s@]+@", "https://[REDACTED]@", text)

print(text, end="" if text.endswith("\n") else "\n")
PYEOF
}

cmd_report() {
    local arg1="${1:-}"
    local arg2="${2:-}"
    local to_stdout="0"
    local inst_id=""
    if [ "${arg1}" = "--stdout" ]; then
        to_stdout="1"
        inst_id="${arg2}"
    elif [ "${arg2}" = "--stdout" ]; then
        to_stdout="1"
        inst_id="${arg1}"
    else
