#!/usr/bin/env bash
# ==============================================================================
# comfy — CLI helper para macOS / Linux para gestionar instancias ComfyUIPod en Vast.ai
# ==============================================================================
# Subcomandos (§10.1):
#   comfy [open] [id] [home|comfy|status|report|terminal]
#   comfy url [id]
#   comfy all
#   comfy logs [id] [N]
#   comfy pass [id]
#   comfy report [id]
#   comfy watch [id]
#   comfy rent [all|general|realistic|anime|minimal]
#   comfy destroy <id>
# ==============================================================================

set -euo pipefail

COMFY_IMAGE="${COMFY_IMAGE:-}"
COMFY_USER="${COMFY_USER:-admin}"

die() {
    echo "[ERROR] $*" >&2
    exit 1
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "Comando requerido no encontrado: '$1'. Instálalo antes de continuar."
}

# V27: Rechazar saltos de línea en la contraseña: un \n o \r inyectaría líneas
# de configuración extra en el config de stdin de curl (-K -) y rompería --env.
check_pass_safe() {
    case "$1" in
        *$'\n'*|*$'\r'*)
            die "La contraseña contiene saltos de línea (\\n o \\r); no es válida. Eliminalos de COMFY_PASS."
            ;;
    esac
}

# O-13: Pasar credenciales por stdin a curl (-K -) para no exponerlas en ps aux
curl_auth() {
    require_cmd curl
    local user="$1"
    local pass="$2"
    shift 2
    check_pass_safe "${pass}"
    local escaped_pass="${pass//\\/\\\\}"
    escaped_pass="${escaped_pass//\"/\\\"}"
    printf 'user = "%s:%s"\n' "${user}" "${escaped_pass}" | curl -K - "$@"
}

# O-14: Respetar COMFY_BROWSER y distinguir Darwin (macOS) vs Linux
open_browser() {
    local target_url="$1"
    if [ -n "${COMFY_BROWSER:-}" ]; then
        "${COMFY_BROWSER}" "${target_url}"
    elif [ "$(uname -s)" = "Darwin" ] && command -v open >/dev/null 2>&1; then
        /usr/bin/open "${target_url}"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "${target_url}"
    else
        echo "${target_url}"
    fi
}

# Obtiene JSON crudo de vastai show instances --raw
fetch_instances_json() {
    require_cmd vastai
    require_cmd python3
    vastai show instances --raw
}

# Resuelve ID, IP y HostPort (8188/tcp) de una instancia activa.
# Salida: "<id>|<ip>|<port>|<status>|<label>"
resolve_instance() {
    local requested_id="${1:-}"
    local allow_starting="${2:-0}"
    local raw_json
    raw_json="$(fetch_instances_json)"

    RAW_JSON="${raw_json}" python3 - "${requested_id}" "${allow_starting}" << 'PYEOF'
import json, os, sys

req_id = sys.argv[1].strip()
allow_starting = sys.argv[2].strip() == "1"
raw = os.environ.get("RAW_JSON", "")
try:
    parsed = json.loads(raw)
except Exception as e:
    sys.stderr.write(f"[ERROR] No se pudo parsear 'vastai show instances --raw': {e}\n")
    sys.exit(1)

if isinstance(parsed, dict):
    instances = parsed.get("instances") or parsed.get("rows") or []
elif isinstance(parsed, list):
    instances = parsed
else:
    instances = []

def extract_port(inst):
    ports = inst.get("ports") or {}
    tcp_8188 = ports.get("8188/tcp")
    if isinstance(tcp_8188, list) and tcp_8188:
        hp = tcp_8188[0].get("HostPort") or tcp_8188[0].get("host_port")
        if hp:
            return str(hp)
    # Solo para instancias legadas creadas con --direct (runtype jupyter/ssh);
    # las instancias nuevas (runtype args) siempre usan el mapeo proxy de ports.
    direct_start = inst.get("direct_port_start")
    if direct_start and int(direct_start) > 0:
        return str(direct_start)
    return ""

candidates = []
for inst in instances:
    iid = str(inst.get("id", ""))
    status = str(inst.get("actual_status") or inst.get("status_msg") or "unknown")
    ip = str(inst.get("public_ipaddr") or "").strip()
    port = extract_port(inst)
    label = str(inst.get("label") or "")
    if req_id:
        if iid == req_id:
            candidates.append((0, iid, ip, port, status, label))
            break
    else:
        if (status == "running" and ip and port) or (allow_starting and status in ("running", "loading", "creating", "starting")):
            prio = 0 if label.lower().startswith("comfy") else 1
            if status != "running":
                prio += 2
            candidates.append((prio, iid, ip, port, status, label))

if not candidates:
    if req_id:
        sys.stderr.write(f"[ERROR] No se encontró la instancia con ID {req_id}.\n")
    else:
        sys.stderr.write("[ERROR] No se encontró ninguna instancia activa con puerto 8188/tcp mapeado.\n")
    sys.exit(1)

candidates.sort(key=lambda x: x[0])
_, iid, ip, port, status, label = candidates[0]
print(f"{iid}|{ip}|{port}|{status}|{label}")
PYEOF
}

fetch_logs_text() {
    local inst_id="$1"
    local tail_n="${2:-300}"
    require_cmd vastai
    require_cmd curl
    local out
    out="$(vastai logs "${inst_id}" --tail "${tail_n}" 2>&1 || true)"
    # Compatibilidad con versiones antiguas de vastai CLI que devolvían una URL S3
    if [[ "${out}" =~ ^https?:// ]]; then
        curl -fsSL "${out}" 2>/dev/null || printf '%s\n' "${out}"
    else
        local s3_url
        s3_url="$(printf '%s\n' "${out}" | grep -Eo 'https://[^[:space:]"'\'']+' | tail -n 1 || true)"
        if [ -n "${s3_url}" ] && [ "$(printf '%s\n' "${out}" | wc -l)" -le 3 ]; then
            curl -fsSL "${s3_url}" 2>/dev/null || printf '%s\n' "${out}"
        else
            printf '%s\n' "${out}"
        fi
    fi
}

cmd_all() {
    local raw_json
    raw_json="$(fetch_instances_json)"
    RAW_JSON="${raw_json}" python3 - << 'PYEOF'
import json, os, sys

raw = os.environ.get("RAW_JSON", "")
parsed = json.loads(raw)
instances = parsed.get("instances", []) if isinstance(parsed, dict) else parsed

if not instances:
    print("No hay instancias activas en tu cuenta de Vast.ai.")
    sys.exit(0)

header = f"{'ID':<10} {'ESTADO':<10} {'GPU':<18} {'$/h':<7} {'LABEL':<18} {'PORTAL (/home)':<36} {'STATUS (/status)'}"
print(header)
print("-" * len(header))
for inst in instances:
    iid = str(inst.get("id", ""))
    status = str(inst.get("actual_status") or "unknown")
    gpu = str(inst.get("gpu_name") or "?")[:17]
    dph = float(inst.get("dph_total") or 0.0)
    label = str(inst.get("label") or "-")[:17]
    ip = str(inst.get("public_ipaddr") or "").strip()
    ports = inst.get("ports") or {}
    tcp = ports.get("8188/tcp") or []
    port = str(tcp[0].get("HostPort", "")) if tcp else ""
    base = f"http://{ip}:{port}" if (ip and port) else "(sin puerto público)"
    home_url = f"{base}/home" if ip and port else base
    stat_url = f"{base}/status" if ip and port else "-"
    print(f"{iid:<10} {status:<10} {gpu:<18} {dph:<7.3f} {label:<18} {home_url:<36} {stat_url}")
PYEOF
}

cmd_url() {
    local inst_id="${1:-}"
    local info ip port
    info="$(resolve_instance "${inst_id}")"
    IFS='|' read -r _ ip port _ _ <<<"${info}"
    if [ -z "${ip}" ] || [ -z "${port}" ]; then
        die "La instancia aún no expone IP/puerto público."
    fi
    echo "http://${ip}:${port}"
}

cmd_open() {
    local arg1="${1:-}"
    local arg2="${2:-}"
    local inst_id=""
    local target_view="home"

    case "${arg1}" in
        home|comfy|status|report|terminal|"")
            target_view="${arg1:-home}"
            ;;
        *)
            inst_id="${arg1}"
            target_view="${arg2:-home}"
            ;;
    esac

    local path_suffix
    case "${target_view}" in
        home)     path_suffix="/home" ;;
        comfy)    path_suffix="/" ;;
        status)   path_suffix="/status" ;;
        report)   path_suffix="/report.md" ;;
        terminal) path_suffix="/terminal/" ;;
        *)        die "Vista no reconocida: '${target_view}'. Usa: home | comfy | status | report | terminal" ;;
    esac

    # O-14: Esperar hasta 10 min (200 * 3s) si la instancia sigue arrancando o Nginx aún no responde
    require_cmd curl
    local deadline=$((SECONDS + 600))
    local resolved_id="" ip="" port="" status=""
    local healthz_ok="0"
    local portal_ok="0"
    local resolve_err_file="/tmp/comfy-resolve-err.$$"
    while [ "${SECONDS}" -lt "${deadline}" ]; do
        local info=""
        if info="$(resolve_instance "${inst_id}" "1" 2>"${resolve_err_file}")"; then
            IFS='|' read -r resolved_id ip port status _ <<<"${info}"
            if [ "${status}" = "exited" ] || [ "${status}" = "stopped" ]; then
                rm -f "${resolve_err_file}"
                echo "[FATAL] La instancia ${resolved_id} pasó a estado '${status}' (probable fallo de arranque estricto STRICT_START=1 / código 20)." >&2
                echo "        Ejecuta 'comfy logs ${resolved_id}' para ver el motivo y 'comfy destroy ${resolved_id}' para detener el cobro de disco." >&2
                return 1
            fi
            if [ "${status}" = "running" ] && [ -n "${ip}" ] && [ -n "${port}" ]; then
                # -I (HEAD): /healthz responde sin cuerpo (proxy_method HEAD); un GET colgaria
                # hasta --max-time pese al 200 real y nunca romperia el bucle de espera.
                if curl -fsSI --max-time 3 "http://${ip}:${port}/healthz" >/dev/null 2>&1; then
                    healthz_ok="1"
                    break
                fi
                # R-10: Si /healthz devuelve 502 (Fase 1 en curso o ventana de gracia de strict FATAL),
                # comprobar si Nginx ya responde en /home (200/401) y consultar /status/api si hay credenciales.
                local home_code
                home_code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "http://${ip}:${port}/home" 2>/dev/null || echo "000")"
                if [ "${home_code}" = "200" ] || [ "${home_code}" = "401" ]; then
                    local probe_pass="${COMFY_PASS:-}"
                    if [ -z "${probe_pass}" ]; then
                        probe_pass="$(cmd_pass "${resolved_id}" 2>/dev/null || true)"
                    fi
                    if [ -n "${probe_pass}" ]; then
                        local api_json
                        api_json="$(curl_auth "${COMFY_USER}" "${probe_pass}" -fsSL --max-time 3 "http://${ip}:${port}/status/api" 2>/dev/null || true)"
                        if [ -n "${api_json}" ]; then
                            if API_JSON="${api_json}" python3 -c 'import json, os, sys; sys.exit(0 if (json.loads(os.environ["API_JSON"]).get("strict") or {}).get("result") == "fatal" else 1)' 2>/dev/null; then
                                rm -f "${resolve_err_file}"
                                echo "[FATAL] La instancia ${resolved_id} falló el arranque estricto (strict.result=fatal):" >&2
                                API_JSON="${api_json}" python3 -c '
import json, os, sys
st = json.loads(os.environ["API_JSON"]).get("strict") or {}
for c in st.get("checks") or []:
    if c.get("status") == "fatal":
        print(f"  * {c.get(\"id\")} ({c.get(\"name\")}): {c.get(\"detail\")}", file=sys.stderr)
        if c.get("remediation"):
            print(f"    Remediación: {c.get(\"remediation\")}", file=sys.stderr)
'
                                echo "Abriendo http://${ip}:${port}/home para inspección y abortando espera..." >&2
                                open_browser "http://${ip}:${port}/home"
                                return 20
                            fi
                        fi
                    fi
                    if [ "${target_view}" != "comfy" ]; then
                        portal_ok="1"
                        break
                    fi
                fi
            fi
            echo "[INFO] Instancia ${resolved_id} en estado '${status}' (${ip:-sin-ip}:${port:-sin-puerto}); esperando a que Nginx responda..." >&2
        else
            # V27: solo ocultar el stderr esperado de "aún no aparece"; otros errores
            # (API key caducada, fallo de red, JSON inválido) se muestran en vez de
            # hacer esperar 10 min en silencio.
            local resolve_err=""
            resolve_err="$(cat "${resolve_err_file}" 2>/dev/null || true)"
            case "${resolve_err}" in
                ""|*"No se encontró"*)
                    echo "[INFO] Esperando a que la instancia aparezca en Vast.ai..." >&2
                    ;;
                *)
                    rm -f "${resolve_err_file}"
                    die "Error al resolver la instancia en Vast.ai: ${resolve_err}"
                    ;;
            esac
        fi
        sleep 3
    done
    rm -f "${resolve_err_file}"

    if [ -z "${ip}" ] || [ -z "${port}" ]; then
        die "Timeout (10 min) esperando IP/puerto público de la instancia."
    fi

    if [ "${healthz_ok}" != "1" ] && [ "${portal_ok}" != "1" ]; then
        # No die: el portal puede seguir levantándose; Nginx mostrará su página
        # de auto-refresco /_starting.html o aún no responderá.
        echo "[WARN] /healthz no respondió OK en 10 min; el portal puede no estar listo aún (página _starting.html o en blanco). Revisa 'comfy logs ${resolved_id}'." >&2
    fi

    local full_url="http://${ip}:${port}${path_suffix}"
    echo "Abriendo ${full_url} ..."
    open_browser "${full_url}"
}

cmd_logs() {
    local inst_id="${1:-}"
    local tail_n="${2:-300}"
    if [[ "${inst_id}" =~ ^[0-9]+$ ]] && [ -z "${2:-}" ]; then
        # Si solo se pasó un número, verificar si coincide con una instancia; si no, asumir tail_n
        local info
        if info="$(resolve_instance "${inst_id}" 2>/dev/null)"; then
            IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
        else
            tail_n="${inst_id}"
            info="$(resolve_instance "")"
            IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
        fi
    else
        local info
        info="$(resolve_instance "${inst_id}")"
        IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
    fi
    fetch_logs_text "${inst_id}" "${tail_n}"
}

cmd_pass() {
    local inst_id="${1:-}"
    local info
    info="$(resolve_instance "${inst_id}")"
    IFS='|' read -r inst_id _ _ _ _ <<<"${info}"
    local logs_txt
    logs_txt="$(fetch_logs_text "${inst_id}" 500)"
    local auto_pass
    auto_pass="$(printf '%s\n' "${logs_txt}" | sed -n 's/.*Contraseña[[:space:]]*:[[:space:]]*\([a-fA-F0-9]\{16,\}\).*/\1/p' | tail -n 1)"
    if [ -n "${auto_pass}" ]; then
        echo "${auto_pass}"
    elif printf '%s\n' "${logs_txt}" | grep -q "definida por el usuario en COMFY_PASS"; then
        echo "[INFO] La instancia usa la contraseña definida manualmente por el usuario en COMFY_PASS." >&2
        return 1
    else
        echo "[WARN] Aún no se encontró la línea de credenciales en los logs de la instancia ${inst_id}." >&2
        return 1
    fi
}

resolve_auth_pass() {
    local inst_id="$1"
    if [ -n "${COMFY_PASS:-}" ]; then
        check_pass_safe "${COMFY_PASS}"
        echo "${COMFY_PASS}"
        return 0
    fi
    local detected
    if detected="$(cmd_pass "${inst_id}" 2>/dev/null)" && [ -n "${detected}" ]; then
        echo "${detected}"
        return 0
    fi
    read -r -s -p "Introduce COMFY_PASS para ${COMFY_USER}: " input_pass >&2 || die "Entrada cerrada (EOF)."
    echo "" >&2
    check_pass_safe "${input_pass}"
    echo "${input_pass}"
}

cmd_report() {
    local arg1="${1:-}"
    local arg2="${2:-}"
    local to_stdout="0"
    local inst_id=""
    if [ "${arg1}" = "--stdout" ]; then
        to_stdout="1"
        inst_id="${arg2}"
    elif [ "${arg2}" = "--stdout" ]; then
        to_stdout="1"
        inst_id="${arg1}"
    else
        inst_id="${arg1}"
    fi

    local info ip port
    info="$(resolve_instance "${inst_id}")"
    IFS='|' read -r inst_id ip port _ _ <<<"${info}"
    local pass
    pass="$(resolve_auth_pass "${inst_id}")"

    if [ "${to_stdout}" = "1" ]; then
        curl_auth "${COMFY_USER}" "${pass}" -fsSL "http://${ip}:${port}/report.md"
        return 0
    fi

    local out_file="/tmp/comfy-report-${inst_id}.md"
    curl_auth "${COMFY_USER}" "${pass}" -fsSL "http://${ip}:${port}/report.md" -o "${out_file}"
    echo "Informe guardado en: ${out_file} ($(wc -c <"${out_file}" | tr -d ' ') bytes)"
    if command -v pbcopy >/dev/null 2>&1; then
        pbcopy <"${out_file}"
        echo "Copiado al portapapeles de macOS (pbcopy)."
    fi
}

cmd_watch() {
    local inst_id="${1:-}"
    local info ip port
    info="$(resolve_instance "${inst_id}")"
    IFS='|' read -r inst_id ip port _ _ <<<"${info}"
    local pass
    pass="$(resolve_auth_pass "${inst_id}")"
    local api_url="http://${ip}:${port}/status/api"

    echo "Monitorizando ${api_url} cada 3s (Ctrl+C para salir)..."
    while true; do
        local json_payload
        if json_payload="$(curl_auth "${COMFY_USER}" "${pass}" -fsSL --max-time 5 "${api_url}" 2>/dev/null)"; then
            clear
            API_JSON="${json_payload}" python3 - << 'PYEOF'
import json, os

d = json.loads(os.environ["API_JSON"])
inst = d.get("instance") or {}
gpu = d.get("gpu") or {}
mem = d.get("memory") or {}
disk = d.get("disk") or {}
c = d.get("comfyui") or {}
dl = d.get("phases") or {}
p1 = dl.get("phase1") or {}
p2 = dl.get("phase2") or {}
triage = d.get("triage") or []

print(f"=== ComfyUIPod Watch | {d.get('generated_at','')} | uptime={inst.get('uptime_s',0)}s ===")
print(f"Banner    : {d.get('phase_banner','')}")
strict = d.get("strict") or {}
if strict.get("result") == "fatal":
    print("\n[FATAL] ARRANQUE ESTRICTO FALLIDO — HOST INCOMPATIBLE:")
    for chk in strict.get("checks") or []:
        if chk.get("status") == "fatal":
            print(f"  * {chk.get('id')} ({chk.get('name')}): {chk.get('detail')}")
            if chk.get("remediation"):
                print(f"    Remediación: {chk.get('remediation')}")
print(f"ComfyUI   : state={c.get('state')} | port_open={c.get('port_open')} | restarts={c.get('restarts')}/{c.get('max_restarts')}")
print(f"GPU       : {gpu.get('name','N/A')} | VRAM {gpu.get('vram_used_mb',0)}/{gpu.get('vram_total_mb',0)} MB | util={gpu.get('util_pct',0)}% | {gpu.get('temp_c',0)}C")
print(f"RAM / Disk: disponible={mem.get('available_mb',0)}/{mem.get('total_mb',0)} MB | disco libre={disk.get('free_gb',0)}/{disk.get('total_gb',0)} GB")
print(f"Fase 1    : {p1.get('state')} ({p1.get('done',0)}/{p1.get('total',12)})")
print(f"Fase 2    : {p2.get('state')} ({p2.get('done',0)}/{p2.get('total',0)}) | actual={p2.get('current_file') or '-'}")
if triage:
    print("\nAlertas de triaje activas:")
    for t in triage[:5]:
        print(f"  - [{t.get('severity','').upper()}] {t.get('pattern_id')}: {t.get('summary')}")
PYEOF
            if API_JSON="${json_payload}" python3 -c 'import json, os, sys; sys.exit(0 if (json.loads(os.environ["API_JSON"]).get("strict") or {}).get("result") == "fatal" else 1)' 2>/dev/null; then
                echo ""
                echo "[FATAL] La instancia ${inst_id} falló el arranque estricto y se cerrará tras la ventana de gracia." >&2
                echo "        Ejecuta ahora: comfy destroy ${inst_id}" >&2
                return 20
            fi
        else
            echo "[WARN] Sin respuesta desde ${api_url} (verifica estado con 'comfy status' o 'comfy logs ${inst_id}')..."
        fi
        sleep 3
    done
}

# V27: Buscar ofertas sin enmascarar errores de vastai como "sin ofertas".
# Solo se degrada a "[]" cuando vastai terminó bien y no escribió nada en stderr;
# un fallo real (API key caducada, red, etc.) se muestra y aborta el script.
search_offers() {
    local q="$1"
    local err_file="/tmp/comfy-search-err.$$"
    local out="" rc=0
    out="$(vastai search offers "${q}" -o "dph_total" --raw 2>"${err_file}")" || rc=$?
    local err_txt=""
    err_txt="$(cat "${err_file}" 2>/dev/null || true)"
    rm -f "${err_file}"
    if [ "${rc}" -ne 0 ]; then
        die "vastai search offers falló (rc=${rc}): ${err_txt:-sin mensaje de error}"
    fi
    if [ -z "${out}" ] && [ -n "${err_txt}" ]; then
        die "vastai search offers no devolvió stdout pero sí errores: ${err_txt}"
    fi
    if [ -z "${out}" ]; then
        printf '[]'
        return 0
    fi
    printf '%s' "${out}"
}

cmd_rent() {
    require_cmd vastai
    require_cmd python3

    local profile="all"
    local dry_run="0"
    local assume_yes="0"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dry-run)
                dry_run="1"
                ;;
            -y|--yes)
                assume_yes="1"
                ;;
            all|general|realistic|anime|minimal)
                profile="$1"
                ;;
            *)
                die "Argumento no reconocido en 'comfy rent': '$1'. Uso: comfy rent [all|general|realistic|anime|minimal] [--dry-run] [--yes]"
                ;;
        esac
        shift
    done

    # O-12: Exigir COMFY_IMAGE explícitamente en lugar de asumir un GHCR ajeno por defecto
    [ -n "${COMFY_IMAGE}" ] || die "La variable COMFY_IMAGE no está definida. Exporta tu imagen antes de alquilar (ej.: export COMFY_IMAGE=ghcr.io/<tu-usuario>/comfyuipod:latest)."

    local pass="${COMFY_PASS:-}"
    check_pass_safe "${pass}"
    # O-01b: Filtros alineados con la guía de despliegue (cpu_ram>=32, cuda_vers>=12.8).
    # V27: cuda_vers es el campo documentado en vastai search offers ("machine max
    # supported cuda version"); cuda_max_good no existe en el esquema documentado.
    # Sin --direct no se exige direct_port_count: los puertos van proxy-mapeados.
    local base_filters="gpu_ram>=24 cpu_ram>=32 cuda_vers>=12.8 inet_down>=500 disk_space>=120 reliability>=0.98 verified=true rentable=true"
    local query="gpu_name=RTX_5090 ${base_filters}"

    echo "Buscando ofertas RTX 5090 en Vast.ai (perfil=${profile})..."
    local offers_json
    offers_json="$(search_offers "${query}")"

    local offer_id
    offer_id="$(OFFERS_JSON="${offers_json}" python3 -c '
import json, os
data = json.loads(os.environ.get("OFFERS_JSON", "[]"))
rows = data.get("offers", data) if isinstance(data, dict) else data
print(rows[0]["id"] if rows else "")
' 2>/dev/null || true)"

    if [ -z "${offer_id}" ]; then
        echo "No se encontraron RTX 5090 disponibles; buscando fallback RTX 4090..."
        query="gpu_name=RTX_4090 ${base_filters}"
        offers_json="$(search_offers "${query}")"
        offer_id="$(OFFERS_JSON="${offers_json}" python3 -c '
import json, os
data = json.loads(os.environ.get("OFFERS_JSON", "[]"))
rows = data.get("offers", data) if isinstance(data, dict) else data
print(rows[0]["id"] if rows else "")
' 2>/dev/null || true)"
    fi

    [ -n "${offer_id}" ] || die "No se encontraron ofertas disponibles que cumplan los filtros (${base_filters})."

    # O-01a: Mostrar tabla de las 5 ofertas más baratas con coste total estimado (GPU + 120 GB disco)
    OFFERS_JSON="${offers_json}" python3 - << 'PYEOF'
import json, os

data = json.loads(os.environ.get("OFFERS_JSON", "[]"))
rows = data.get("offers", data) if isinstance(data, dict) else data
top5 = rows[:5]

print("\nTop 5 ofertas más económicas encontradas (disco solicitado: 120 GB):")
hdr = f"{'#':<3} {'OFFER_ID':<10} {'GPU':<12} {'VRAM':<7} {'HOST_RAM':<9} {'CUDA':<6} {'DOWN_Mbps':<10} {'$/GB·mes':<9} {'GPU_$/h':<8} {'TOTAL_EST_$/h'}"
print(hdr)
print("-" * len(hdr))
for idx, r in enumerate(top5, 1):
    oid = str(r.get("id", ""))
    gpu = str(r.get("gpu_name", "?"))[:11]
    vram_raw = float(r.get("gpu_ram") or 0)
    vram_gb = vram_raw / 1024.0 if vram_raw > 256 else vram_raw
    cram_raw = float(r.get("cpu_ram") or 0)
    cram_gb = cram_raw / 1024.0 if cram_raw > 512 else cram_raw
    cuda = str(r.get("cuda_vers") or "?")
    down = float(r.get("inet_down") or 0)
    storage_cost = float(r.get("storage_cost") or 0.15)
    dph = float(r.get("dph_total") or r.get("dph_base") or 0.0)
    disk_dph = (120.0 * storage_cost) / 730.0
    total_dph = dph + disk_dph if not r.get("dph_total") else dph
    mark = "*" if idx == 1 else " "
    print(f"{idx}{mark:<2} {oid:<10} {gpu:<12} {vram_gb:>4.0f}GB {cram_gb:>6.0f}GB {cuda:<6} {down:>8.0f} {storage_cost:>8.3f} {dph:>7.3f} ${total_dph:>7.3f}/h")
print("")
PYEOF

    # S-07 / V27 (contrato de entrecomillado verificado contra vast.py de vast-cli):
    # vast-cli solo limpia comillas del valor, nunca de la clave; se comilla SOLO el
    # valor. `-e "COMFY_PASS=abc def"` crearia una variable llamada «COMFY_PASS (con
    # comilla en la clave), por lo que se construye `-e COMFY_PASS="abc def"`.
    # -p 8188:8188 se mantiene sin comillas.
    local env_flags="-p 8188:8188 -e MODEL_PROFILE=\"${profile}\" -e COMFY_USER=\"${COMFY_USER}\""
    if [ -n "${pass}" ]; then
        env_flags="${env_flags} -e COMFY_PASS=\"${pass}\""
    fi
    if [ -n "${HF_TOKEN:-}" ]; then
        env_flags="${env_flags} -e HF_TOKEN=\"${HF_TOKEN}\""
    fi
    # O-01d / R-14: Reenviar variables opcionales (valor entrecomillado) si están definidas en la Mac
    if [ -n "${COMFYUI_EXTRA_ARGS:-}" ]; then
        env_flags="${env_flags} -e COMFYUI_EXTRA_ARGS=\"${COMFYUI_EXTRA_ARGS}\""
    fi
    if [ -n "${HF_HUB_DISABLE_XET:-}" ]; then
        env_flags="${env_flags} -e HF_HUB_DISABLE_XET=\"${HF_HUB_DISABLE_XET}\""
    fi
    if [ -n "${ENABLE_WEB_TERMINAL:-}" ]; then
        env_flags="${env_flags} -e ENABLE_WEB_TERMINAL=\"${ENABLE_WEB_TERMINAL}\""
    fi

    if [ "${dry_run}" = "1" ]; then
        local pass_state="autogenerada"
        [ -z "${pass}" ] || pass_state="definida (COMFY_PASS)"
        local hf_state="no definida"
        [ -z "${HF_TOKEN:-}" ] || hf_state="definida"
        echo "[DRY-RUN] Se alquilaría la oferta ID ${offer_id} con imagen ${COMFY_IMAGE} (perfil=${profile}, --args)."
        echo "[DRY-RUN] Env reenviado: COMFY_PASS=${pass_state}, HF_TOKEN=${hf_state}, MODEL_PROFILE=${profile}, COMFYUI_EXTRA_ARGS='${COMFYUI_EXTRA_ARGS:-}', HF_HUB_DISABLE_XET='${HF_HUB_DISABLE_XET:-}', ENABLE_WEB_TERMINAL='${ENABLE_WEB_TERMINAL:-}'."
        return 0
    fi

    if [ "${assume_yes}" != "1" ]; then
        read -r -p "¿Confirmas alquilar la oferta #1 (ID ${offer_id}) con imagen '${COMFY_IMAGE}'? [y/N]: " confirm_ans || die "Entrada cerrada (EOF)."
        case "${confirm_ans}" in
            y|Y|yes|YES) ;;
            *)
                echo "Alquiler cancelado por el usuario."
                return 0
                ;;
        esac
    fi

    # O-01c: runtype="args" (--args) respeta el ENTRYPOINT de la imagen sin
    # sobreescribirlo. Los puertos van proxy-mapeados por vast.ai (el helper lee
    # ports["8188/tcp"][0].HostPort); el flag --direct de vast-cli solo aplica a
    # runtype jupyter/ssh y es inerte en este modo, así que no se pasa.
    echo "Alquilando oferta ID ${offer_id} con imagen ${COMFY_IMAGE}..."
    vastai create instance "${offer_id}" \
        --image "${COMFY_IMAGE}" \
        --disk 120 \
        --label "comfy-${profile}" \
        --env "${env_flags}" \
        --args
}

cmd_destroy() {
    require_cmd vastai
    local inst_id="${1:-}"
    [ -n "${inst_id}" ] || die "Uso: comfy destroy <id>"
    read -r -p "¿Seguro que deseas destruir la instancia ${inst_id}? (Los datos no sincronizados se perderán) [y/N]: " ans || die "Entrada cerrada (EOF)."
    case "${ans}" in
        y|Y|yes|YES)
            vastai destroy instance "${inst_id}"
            ;;
        *)
            echo "Cancelado."
            ;;
    esac
}

subcmd="${1:-open}"
shift || true

case "${subcmd}" in
    open)
        cmd_open "${1:-}" "${2:-}"
        ;;
    home|comfy|status|terminal)
        cmd_open "${subcmd}"
        ;;
    url)
        cmd_url "${1:-}"
        ;;
    all|ls|list)
        cmd_all
        ;;
    logs)
        cmd_logs "${1:-}" "${2:-}"
        ;;
    pass)
        cmd_pass "${1:-}"
        ;;
    report|report-dl)
        cmd_report "${1:-}" "${2:-}"
        ;;
    watch)
        cmd_watch "${1:-}"
        ;;
    rent)
        cmd_rent "$@"
        ;;
    destroy|rm)
        cmd_destroy "${1:-}"
        ;;
    -h|--help|help)
        sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        # Si el primer argumento es un ID numérico, asumir `comfy open <id> [vista]`
        if [[ "${subcmd}" =~ ^[0-9]+$ ]]; then
            cmd_open "${subcmd}" "${1:-home}"
        else
            die "Subcomando desconocido: '${subcmd}'. Usa 'comfy --help'."
        fi
        ;;
esac
