cmd_studio() {
    local first_arg="${1:-}"
    if [ "${first_arg}" = "report" ]; then
        shift || true
        cmd_studio_report "${1:-}" "${2:-}"
        return 0
    fi

    local inst_id="${first_arg}"
    require_cmd curl
    require_cmd "${PYTHON_BIN}"

    local wait_timeout="${COMFY_WAIT_TIMEOUT:-60}"
    local deadline=$((SECONDS + wait_timeout))
    local resolved_id="" ip="" port="" status=""
    local resolve_err_file="/tmp/comfy-studio-resolve-err.$$"

    while [ "${SECONDS}" -lt "${deadline}" ]; do
        local info=""
        if info="$(resolve_instance "${inst_id}" "1" 2>"${resolve_err_file}")"; then
            IFS='|' read -r resolved_id ip port status _ <<<"${info}"
            if [ "${status}" = "exited" ] || [ "${status}" = "stopped" ]; then
                rm -f "${resolve_err_file}"
                die "La instancia ${resolved_id} está en estado '${status}'. Revisa 'comfy logs ${resolved_id}'."
            fi
            if [ "${status}" = "running" ] && [ -n "${ip}" ] && [ -n "${port}" ]; then
                break
            fi
        fi
        sleep 2
    done
    rm -f "${resolve_err_file}"

    if [ -z "${ip}" ] || [ -z "${port}" ]; then
        die "No se pudo resolver IP/puerto público para la instancia ${inst_id:-activa}."
    fi

    local portal_url="http://${ip}:${port}/home"
    local studio_url="http://${ip}:${port}/studio/"
    local health_url="http://${ip}:${port}/studio/api/health"
    local pass
    pass="$(resolve_auth_pass "${resolved_id}")"

    local health_summary=""
    local health_deadline=$((SECONDS + wait_timeout))
    while [ "${SECONDS}" -lt "${health_deadline}" ]; do
        local health_json=""
        if health_json="$(curl_auth "${COMFY_USER}" "${pass}" -fsSL --max-time 5 "${health_url}" 2>/dev/null)"; then
            if health_summary="$(HEALTH_JSON="${health_json}" "${PYTHON_BIN}" - << 'PYEOF'
import json, os, sys
d = json.loads(os.environ.get("HEALTH_JSON", "{}"))
if d.get("status") == "ok" and d.get("server") == "ok":
    key_st = d.get("llm_key_status", "<no definida>")
    if key_st not in ("<definida>", "<no definida>"):
        key_st = "<definida>"
    srv = d.get("server", "ok")
    comfy = d.get("comfyui", "unknown")
    prof = d.get("model_profile", "-")
    sys.stdout.write(f"server={srv}, comfyui={comfy}, model_profile={prof}, llm_key={key_st}\n")
    sys.exit(0)
sys.exit(1)
PYEOF
)"; then
                health_summary="${health_summary%$'\r'}"
                break
            fi
        fi
        local api_json=""
        if api_json="$(curl_auth "${COMFY_USER}" "${pass}" -fsSL --max-time 3 "http://${ip}:${port}/status/api" 2>/dev/null || true)" && [ -n "${api_json}" ]; then
            if API_JSON="${api_json}" "${PYTHON_BIN}" -c 'import json, os, sys; sys.exit(0 if (json.loads(os.environ["API_JSON"]).get("strict") or {}).get("result") == "fatal" else 1)' 2>/dev/null; then
                echo "[FATAL] La instancia ${resolved_id} falló el arranque estricto (strict.result=fatal):" >&2
                API_JSON="${api_json}" "${PYTHON_BIN}" - << 'PYEOF'
import json, os, sys
st = json.loads(os.environ["API_JSON"]).get("strict") or {}
for c in st.get("checks") or []:
    if c.get("status") == "fatal":
        print(f"  * {c.get('id')} ({c.get('name')}): {c.get('detail')}", file=sys.stderr)
        if c.get("remediation"):
            print(f"    Remediación: {c.get('remediation')}", file=sys.stderr)
PYEOF
                echo "Abriendo ${portal_url} para inspección y abortando espera..." >&2
                open_browser "${portal_url}"
                return 20
            fi
        fi
        sleep 1
    done

    if [ -z "${health_summary}" ]; then
        die "El servicio Comfy Studio en ${health_url} no respondió saludable tras ${wait_timeout}s. Verifica con 'comfy studio report ${resolved_id}'."
    fi

    echo "[OK] Portal del pod: ${portal_url}"
    echo "[OK] Salud de Comfy Studio verificada (${health_summary})"
    echo "Abriendo ${studio_url} ..."
    open_browser "${studio_url}"
}

