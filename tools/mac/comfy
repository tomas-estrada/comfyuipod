# V27: Buscar ofertas sin enmascarar errores de vastai como "sin ofertas".
# Solo se degrada a "[]" cuando vastai terminó bien y no escribió nada en stderr;
# un fallo real (API key caducada, red, etc.) se muestra y aborta el script.
search_offers() {
    local q="$1"
    local err_file="/tmp/comfy-search-err.$$"
    local out="" rc=0
    out="$(vastai search offers "${q}" -o "dph_total" --raw 2>"${err_file}")" || rc=$?
    local err_txt=""
    err_txt="$(cat "${err_file}" 2>/dev/null || true)"
    rm -f "${err_file}"
    if [ "${rc}" -ne 0 ]; then
        die "vastai search offers falló (rc=${rc}): ${err_txt:-sin mensaje de error}"
    fi
    if [ -z "${out}" ] && [ -n "${err_txt}" ]; then
        die "vastai search offers no devolvió stdout pero sí errores: ${err_txt}"
    fi
    if [ -z "${out}" ]; then
        printf '[]'
        return 0
    fi
    printf '%s' "${out}"
}

# Filtra y ordena ofertas en cliente (además del filtro servidor de vastai)
# para garantizar que las restricciones de disco, red, GPU, VRAM y fiabilidad
# se cumplan estrictamente también frente a fixtures o respuestas sin filtrar.
filter_offers_json() {
    local raw_offers="$1"
    local target_gpu="$2"
    local min_vram_gb="$3"
    local min_disk_gb="$4"
    local min_inet_down="$5"

    OFFERS_JSON="${raw_offers}" "${PYTHON_BIN}" - "${target_gpu}" "${min_vram_gb}" "${min_disk_gb}" "${min_inet_down}" << 'PYEOF'
import json, os, sys

target_gpu = sys.argv[1].strip().replace(" ", "_").upper()
min_vram_gb = float(sys.argv[2])
min_disk_gb = float(sys.argv[3])
min_inet_down = float(sys.argv[4])

data = json.loads(os.environ.get("OFFERS_JSON", "[]"))
rows = data.get("offers", data) if isinstance(data, dict) else data
if not isinstance(rows, list):
    rows = []

filtered = []
for r in rows:
    if not isinstance(r, dict):
        continue
    gpu_norm = str(r.get("gpu_name") or "").strip().replace(" ", "_").upper()
    if target_gpu and gpu_norm and gpu_norm != target_gpu:
        continue
    vram_raw = float(r.get("gpu_ram") or 0)
    vram_gb = vram_raw / 1024.0 if vram_raw > 256 else vram_raw
    if vram_gb and vram_gb + 0.5 < min_vram_gb:
        continue
    cram_raw = float(r.get("cpu_ram") or 0)
    cram_gb = cram_raw / 1024.0 if cram_raw > 512 else cram_raw
    if cram_gb and cram_gb + 0.5 < 32.0:
        continue
    cuda_v = float(r.get("cuda_vers") or 12.8)
    if cuda_v < 12.8:
        continue
    disk = float(r.get("disk_space") or 0)
    if disk < min_disk_gb:
        continue
    inet = float(r.get("inet_down") or 0)
    if inet and inet < min_inet_down:
        continue
    rel = float(r.get("reliability") or r.get("reliability2") or 1.0)
    if rel < 0.98:
        continue
    if r.get("verified") is False or r.get("rentable") is False:
        continue
    filtered.append(r)

filtered.sort(key=lambda item: float(item.get("dph_total") or item.get("dph_base") or 999999.0))
print(json.dumps(filtered))
PYEOF
}

cmd_rent() {
    require_cmd vastai
    require_cmd "${PYTHON_BIN}"

    local profile="all"
    local dry_run="0"
    local assume_yes="0"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dry-run)
                dry_run="1"
                ;;
            -y|--yes)
                assume_yes="1"
                ;;
            all|general|realistic|anime|minimal|studio)
                profile="$1"
                ;;
            *)
                die "Argumento no reconocido en 'comfy rent': '$1'. Uso: comfy rent [all|general|realistic|anime|minimal|studio] [--dry-run] [--yes]"
                ;;
        esac
        shift
    done

    # O-12: Exigir COMFY_IMAGE explícitamente en lugar de asumir un GHCR ajeno por defecto
    [ -n "${COMFY_IMAGE}" ] || die "La variable COMFY_IMAGE no está definida. Exporta tu imagen antes de alquilar (ej.: export COMFY_IMAGE=ghcr.io/<tu-usuario>/comfyuipod:latest)."

    # Capturar secretos en variables locales y retirarlos del entorno exportado
    # para que ningún proceso hijo (vastai search offers, python3) los herede.
    local pass="${COMFY_PASS:-}"
    local hf_token="${HF_TOKEN:-}"
    local studio_llm_key="${STUDIO_LLM_KEY:-}"
    local studio_llm_fallback_key="${STUDIO_LLM_FALLBACK_KEY:-}"
    unset COMFY_PASS HF_TOKEN STUDIO_LLM_KEY STUDIO_LLM_FALLBACK_KEY

    check_pass_safe "${pass}"
    check_secret_safe "${hf_token}" "HF_TOKEN"
    studio_llm_fallback_key="${studio_llm_fallback_key%$'\r'}"
    check_secret_safe "${studio_llm_fallback_key}" "STUDIO_LLM_FALLBACK_KEY"

    local disk_gb="120"
    local min_vram_gb="24"
    local min_inet_down="500"
    if [ "${profile}" = "studio" ]; then
        min_vram_gb="32"
        min_inet_down="5000"
        # Decisión del manifiesto Fase 3: el perfil studio requiere >= 200 GB de disco
        # (~163.24 GB / ~152.03 GiB en 77 modelos + espacio de trabajo y S5=180 GB), y >= 250 GB
        # si se activa el opt-in STUDIO_INCLUDE_ANIMATE=1 (+18.41 GB de wan2.2_animate_14B_int8_convrot).
        local min_studio_disk_gb="200"
        if [ "${STUDIO_INCLUDE_ANIMATE:-0}" = "1" ]; then
            min_studio_disk_gb="250"
        fi
        disk_gb="${COMFY_DISK_GB:-${min_studio_disk_gb}}"
        if ! [[ "${disk_gb}" =~ ^[0-9]+$ ]] || [ "${disk_gb}" -lt "${min_studio_disk_gb}" ]; then
            die "COMFY_DISK_GB='${disk_gb}' es insuficiente o inválido para 'comfy rent studio': el perfil 'studio' requiere al menos ${min_studio_disk_gb} GB de disco (>=200 GB base; >=250 GB con STUDIO_INCLUDE_ANIMATE=1 para alojar ~163.24 GB de modelos y cumplir S5=180 GB)."
        fi

        # VAL-SERVER-005: Lectura oculta (read -r -s) de STUDIO_LLM_KEY sin eco en terminal,
        # sin escritura a disco y sin historial del shell.
        if [ -z "${studio_llm_key}" ] && [ "${STUDIO_STUB_LLM:-0}" != "1" ]; then
            read -r -s -p "Introduce STUDIO_LLM_KEY (lectura oculta, sin eco ni persistencia en disco): " studio_llm_key >&2 || die "Entrada cerrada (EOF) al leer STUDIO_LLM_KEY."
            echo "" >&2
        fi
        studio_llm_key="${studio_llm_key%$'\r'}"
        check_secret_safe "${studio_llm_key}" "STUDIO_LLM_KEY"
        if [ -z "${studio_llm_key}" ] && [ "${STUDIO_STUB_LLM:-0}" != "1" ]; then
            die "STUDIO_LLM_KEY no puede estar vacía para 'comfy rent studio' (o define STUDIO_STUB_LLM=1 para modo stub)."
        fi
    else
        disk_gb="${COMFY_DISK_GB:-120}"
        if ! [[ "${disk_gb}" =~ ^[0-9]+$ ]] || [ "${disk_gb}" -le 0 ]; then
            die "COMFY_DISK_GB='${disk_gb}' no es válido: debe ser un entero positivo en GB."
        fi
    fi

    # O-01b: Filtros alineados con la guía de despliegue (cpu_ram>=32, cuda_vers>=12.8).
    # V27: cuda_vers es el campo documentado en vastai search offers ("machine max
    # supported cuda version"); cuda_max_good no existe en el esquema documentado.
    # Sin --direct no se exige direct_port_count: los puertos van proxy-mapeados.
    local base_filters="gpu_ram>=${min_vram_gb} cpu_ram>=32 cuda_vers>=12.8 inet_down>=${min_inet_down} disk_space>=${disk_gb} reliability>=0.98 verified=true rentable=true"
    local query="gpu_name=RTX_5090 ${base_filters}"

    echo "Buscando ofertas RTX 5090 en Vast.ai (perfil=${profile}, disco>=${disk_gb} GB, red>=${min_inet_down} Mbps)..."
    local raw_offers offers_json
    raw_offers="$(search_offers "${query}")"
    offers_json="$(filter_offers_json "${raw_offers}" "RTX_5090" "${min_vram_gb}" "${disk_gb}" "${min_inet_down}")"

    local offer_id
    offer_id="$(OFFERS_JSON="${offers_json}" "${PYTHON_BIN}" -c '
import json, os
rows = json.loads(os.environ.get("OFFERS_JSON", "[]"))
print(rows[0]["id"] if rows else "")
' 2>/dev/null || true)"

    if [ -z "${offer_id}" ] && [ "${profile}" != "studio" ]; then
        echo "No se encontraron RTX 5090 disponibles; buscando fallback RTX 4090..."
        query="gpu_name=RTX_4090 ${base_filters}"
        raw_offers="$(search_offers "${query}")"
        offers_json="$(filter_offers_json "${raw_offers}" "RTX_4090" "${min_vram_gb}" "${disk_gb}" "${min_inet_down}")"
        offer_id="$(OFFERS_JSON="${offers_json}" "${PYTHON_BIN}" -c '
import json, os
rows = json.loads(os.environ.get("OFFERS_JSON", "[]"))
print(rows[0]["id"] if rows else "")
' 2>/dev/null || true)"
    fi

    [ -n "${offer_id}" ] || die "No se encontraron ofertas disponibles que cumplan los filtros (${query})."

    # O-01a: Mostrar tabla de las 5 ofertas más baratas con coste total estimado (GPU + disco solicitado)
    OFFERS_JSON="${offers_json}" DISK_GB="${disk_gb}" "${PYTHON_BIN}" - << 'PYEOF'
import json, os

data = json.loads(os.environ.get("OFFERS_JSON", "[]"))
rows = data.get("offers", data) if isinstance(data, dict) else data
disk_gb = float(os.environ.get("DISK_GB", "120"))
top5 = rows[:5]

print(f"\nTop 5 ofertas más económicas encontradas (disco solicitado: {disk_gb:.0f} GB):")
hdr = f"{'#':<3} {'OFFER_ID':<10} {'GPU':<12} {'VRAM':<7} {'HOST_RAM':<9} {'CUDA':<6} {'DISK_GB':<8} {'DOWN_Mbps':<10} {'$/GB·mes':<9} {'GPU_$/h':<8} {'TOTAL_EST_$/h'}"
print(hdr)
print("-" * len(hdr))
for idx, r in enumerate(top5, 1):
    oid = str(r.get("id", ""))
    gpu = str(r.get("gpu_name", "?"))[:11]
    vram_raw = float(r.get("gpu_ram") or 0)
    vram_gb = vram_raw / 1024.0 if vram_raw > 256 else vram_raw
    cram_raw = float(r.get("cpu_ram") or 0)
    cram_gb = cram_raw / 1024.0 if cram_raw > 512 else cram_raw
    cuda = str(r.get("cuda_vers") or "?")
    avail_disk = float(r.get("disk_space") or disk_gb)
    down = float(r.get("inet_down") or 0)
    storage_cost = float(r.get("storage_cost") or 0.15)
    dph = float(r.get("dph_total") or r.get("dph_base") or 0.0)
    disk_dph = (disk_gb * storage_cost) / 730.0
    total_dph = dph + disk_dph if not r.get("dph_total") else dph
    mark = "*" if idx == 1 else " "
    print(f"{idx}{mark:<2} {oid:<10} {gpu:<12} {vram_gb:>4.0f}GB {cram_gb:>6.0f}GB {cuda:<6} {avail_disk:>6.0f}GB {down:>8.0f} {storage_cost:>8.3f} {dph:>7.3f} ${total_dph:>7.3f}/h")
print("")
PYEOF

    # S-07 / V27 (contrato de entrecomillado verificado contra vast.py de vast-cli):
    # vast-cli solo limpia comillas del valor, nunca de la clave; se comilla SOLO el
    # valor. `-e "COMFY_PASS=abc def"` crearia una variable llamada «COMFY_PASS (con
    # comilla en la clave), por lo que se construye `-e COMFY_PASS="abc def"`.
    # -p 8188:8188 se mantiene sin comillas.
    local env_flags="-p 8188:8188 -e MODEL_PROFILE=\"${profile}\" -e COMFY_USER=\"${COMFY_USER}\""
    if [ -n "${pass}" ]; then
        env_flags="${env_flags} -e COMFY_PASS=\"${pass}\""
    fi
    if [ -n "${hf_token}" ]; then
        env_flags="${env_flags} -e HF_TOKEN=\"${hf_token}\""
    fi
    # O-01d / R-14: Reenviar variables opcionales (valor entrecomillado) si están definidas en la Mac
    if [ -n "${COMFYUI_EXTRA_ARGS:-}" ]; then
        check_secret_safe "${COMFYUI_EXTRA_ARGS}" "COMFYUI_EXTRA_ARGS"
        env_flags="${env_flags} -e COMFYUI_EXTRA_ARGS=\"${COMFYUI_EXTRA_ARGS}\""
    fi
    if [ -n "${HF_HUB_DISABLE_XET:-}" ]; then
        check_secret_safe "${HF_HUB_DISABLE_XET}" "HF_HUB_DISABLE_XET"
        env_flags="${env_flags} -e HF_HUB_DISABLE_XET=\"${HF_HUB_DISABLE_XET}\""
    fi
    if [ -n "${ENABLE_WEB_TERMINAL:-}" ]; then
        check_secret_safe "${ENABLE_WEB_TERMINAL}" "ENABLE_WEB_TERMINAL"
        env_flags="${env_flags} -e ENABLE_WEB_TERMINAL=\"${ENABLE_WEB_TERMINAL}\""
    fi

    if [ "${profile}" = "studio" ]; then
        if [ -n "${studio_llm_key}" ]; then
            env_flags="${env_flags} -e STUDIO_LLM_KEY=\"${studio_llm_key}\""
        fi
        if [ -n "${STUDIO_LLM_BASE_URL:-}" ]; then
            check_secret_safe "${STUDIO_LLM_BASE_URL}" "STUDIO_LLM_BASE_URL"
            env_flags="${env_flags} -e STUDIO_LLM_BASE_URL=\"${STUDIO_LLM_BASE_URL}\""
        fi
        if [ -n "${STUDIO_LLM_MODEL:-}" ]; then
            check_secret_safe "${STUDIO_LLM_MODEL}" "STUDIO_LLM_MODEL"
            env_flags="${env_flags} -e STUDIO_LLM_MODEL=\"${STUDIO_LLM_MODEL}\""
        fi
        if [ -n "${STUDIO_LLM_FALLBACK_BASE_URL:-}" ]; then
            check_secret_safe "${STUDIO_LLM_FALLBACK_BASE_URL}" "STUDIO_LLM_FALLBACK_BASE_URL"
            env_flags="${env_flags} -e STUDIO_LLM_FALLBACK_BASE_URL=\"${STUDIO_LLM_FALLBACK_BASE_URL}\""
        fi
        if [ -n "${studio_llm_fallback_key}" ]; then
            env_flags="${env_flags} -e STUDIO_LLM_FALLBACK_KEY=\"${studio_llm_fallback_key}\""
        fi
        if [ -n "${STUDIO_LLM_FALLBACK_MODEL:-}" ]; then
            check_secret_safe "${STUDIO_LLM_FALLBACK_MODEL}" "STUDIO_LLM_FALLBACK_MODEL"
            env_flags="${env_flags} -e STUDIO_LLM_FALLBACK_MODEL=\"${STUDIO_LLM_FALLBACK_MODEL}\""
        fi
        if [ -n "${STUDIO_INCLUDE_ANIMATE:-}" ]; then
            check_secret_safe "${STUDIO_INCLUDE_ANIMATE}" "STUDIO_INCLUDE_ANIMATE"
            env_flags="${env_flags} -e STUDIO_INCLUDE_ANIMATE=\"${STUDIO_INCLUDE_ANIMATE}\""
        fi
        if [ -n "${STUDIO_STUB_LLM:-}" ]; then
            check_secret_safe "${STUDIO_STUB_LLM}" "STUDIO_STUB_LLM"
            env_flags="${env_flags} -e STUDIO_STUB_LLM=\"${STUDIO_STUB_LLM}\""
        fi
    fi

    if [ "${dry_run}" = "1" ]; then
        local pass_state="autogenerada"
        [ -z "${pass}" ] || pass_state="definida (COMFY_PASS)"
        local hf_state="no definida"
        [ -z "${hf_token}" ] || hf_state="definida"
        local llm_key_state="<no definida>"
        [ -z "${studio_llm_key}" ] || llm_key_state="<definida>"
        local llm_fallback_key_state="<no definida>"
        [ -z "${studio_llm_fallback_key}" ] || llm_fallback_key_state="<definida>"
        echo "[DRY-RUN] Se alquilaría la oferta ID ${offer_id} con imagen ${COMFY_IMAGE} (perfil=${profile}, disco=${disk_gb} GB, --args)."
        echo "[DRY-RUN] Filtros aplicados: ${query}"
        echo "[DRY-RUN] Env reenviado: COMFY_PASS=${pass_state}, HF_TOKEN=${hf_state}, MODEL_PROFILE=${profile}, STUDIO_LLM_KEY=${llm_key_state}, STUDIO_LLM_FALLBACK_KEY=${llm_fallback_key_state}, STUDIO_LLM_MODEL='${STUDIO_LLM_MODEL:-}', STUDIO_INCLUDE_ANIMATE='${STUDIO_INCLUDE_ANIMATE:-0}', COMFYUI_EXTRA_ARGS='${COMFYUI_EXTRA_ARGS:-}', HF_HUB_DISABLE_XET='${HF_HUB_DISABLE_XET:-}', ENABLE_WEB_TERMINAL='${ENABLE_WEB_TERMINAL:-}'."
        return 0
    fi

    if [ "${assume_yes}" != "1" ]; then
        read -r -p "¿Confirmas alquilar la oferta #1 (ID ${offer_id}, disco=${disk_gb} GB) con imagen '${COMFY_IMAGE}'? [y/N]: " confirm_ans || die "Entrada cerrada (EOF)."
        case "${confirm_ans}" in
            y|Y|yes|YES) ;;
            *)
                echo "Alquiler cancelado por el usuario."
                return 0
                ;;
        esac
    fi

    # O-01c: runtype="args" (--args) respeta el ENTRYPOINT de la imagen sin
    # sobreescribirlo. Los puertos van proxy-mapeados por vast.ai (el helper lee
    # ports["8188/tcp"][0].HostPort); el flag --direct de vast-cli solo aplica a
    # runtype jupyter/ssh y es inerte en este modo, así que no se pasa.
    echo "Alquilando oferta ID ${offer_id} con imagen ${COMFY_IMAGE} (perfil=${profile}, disco=${disk_gb} GB)..."
    vastai create instance "${offer_id}" \
        --image "${COMFY_IMAGE}" \
        --disk "${disk_gb}" \
        --label "comfy-${profile}" \
        --env "${env_flags}" \
        --args
}

cmd_destroy() {
    require_cmd vastai
    local inst_id="${1:-}"
    [ -n "${inst_id}" ] || die "Uso: comfy destroy <id>"
    read -r -p "¿Seguro que deseas destruir la instancia ${inst_id}? (Los datos no sincronizados se perderán) [y/N]: " ans || die "Entrada cerrada (EOF)."
    case "${ans}" in
        y|Y|yes|YES)
            vastai destroy instance "${inst_id}"
            ;;
        *)
            echo "Cancelado."
            ;;
    esac
}

subcmd="${1:-open}"
shift || true

case "${subcmd}" in
    open)
        cmd_open "${1:-}" "${2:-}"
        ;;
    home|comfy|status|terminal)
        cmd_open "${subcmd}"
        ;;
    studio)
        cmd_studio "$@"
        ;;
    url)
        cmd_url "${1:-}"
        ;;
    all|ls|list)
        cmd_all
        ;;
    logs)
        cmd_logs "${1:-}" "${2:-}"
        ;;
    pass)
        cmd_pass "${1:-}"
        ;;
    report|report-dl)
        cmd_report "${1:-}" "${2:-}"
        ;;
    watch)
        cmd_watch "${1:-}"
        ;;
    rent)
        cmd_rent "$@"
        ;;
    destroy|rm)
        cmd_destroy "${1:-}"
        ;;
    -h|--help|help)
        sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        # Si el primer argumento es un ID numérico, asumir `comfy open <id> [vista]`
        if [[ "${subcmd}" =~ ^[0-9]+$ ]]; then
            cmd_open "${subcmd}" "${1:-home}"
        else
            die "Subcomando desconocido: '${subcmd}'. Usa 'comfy --help'."
        fi
        ;;
esac
