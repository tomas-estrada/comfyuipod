{
  "id": "wan_i2v",
  "name": "Wan 2.2 14B — Imagen a Vídeo (I2V + Lightning 4-Step)",
  "category": "video_generation",
  "output_kind": "video",
  "summary": "Animación de imagen estática a vídeo con Wan 2.2 I2V 14B fp8_scaled y LoRAs Lightning de 4 pasos.",
  "description": "Anima un fotograma o imagen de referencia convirtiéndolo en un plano de vídeo fluido guiado por texto. Utiliza el par de modelos Wan 2.2 I2V 14B fp8_scaled junto con las LoRAs LightX2V 4-step por defecto.",
  "performance_defaults": {
    "precision": "fp8_scaled",
    "resolution": "480p",
    "width": 832,
    "height": 480,
    "frames": 81,
    "steps": 4,
    "cfg": 1.0,
    "lora_lightning_4step": true,
    "offload": true
  },
  "models": [
    "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
    "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
    "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
    "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
    "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
    "clip_vision_h.safetensors",
    "wan_2.1_vae.safetensors"
  ],
  "required_nodes": [
    "UNETLoader",
    "LoraLoaderModelOnly",
    "CLIPLoader",
    "CLIPVisionLoader",
    "VAELoader",
    "LoadImage",
    "CLIPVisionEncode",
    "CLIPTextEncode",
    "WanImageToVideo",
    "KSamplerAdvanced",
    "VAEDecode",
    "VHS_VideoCombine"
  ],
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "description": "Descripción del movimiento del sujeto, ambiente y cámara a partir de la imagen inicial."
    },
    "negative_prompt": {
      "type": "string",
      "required": false,
      "default": "borroso, baja calidad, estático, deformación facial, artefactos",
      "description": "Defectos o elementos visuales a evitar en la animación."
    },
    "width": {
      "type": "integer",
      "required": false,
      "default": 832,
      "min": 256,
      "max": 1280,
      "description": "Ancho del vídeo en píxeles (832 por defecto)."
    },
    "height": {
      "type": "integer",
      "required": false,
      "default": 480,
      "min": 256,
      "max": 1280,
      "description": "Alto del vídeo en píxeles (480 por defecto)."
    },
    "frames": {
      "type": "integer",
      "required": false,
      "default": 81,
      "min": 1,
      "max": 241,
      "description": "Duración en fotogramas (81 frames ≈ 5 s a 16 fps)."
    },
    "steps": {
      "type": "integer",
      "required": false,
      "default": 4,
      "min": 1,
      "max": 50,
      "description": "Pasos totales de muestreo (4 por defecto con LoRA Lightning)."
    },
    "cfg": {
      "type": "number",
      "required": false,
      "default": 1.0,
      "min": 1.0,
      "max": 15.0,
      "description": "Escala CFG (1.0 por defecto con LoRA Lightning)."
    },
    "seed": {
      "type": "integer",
      "required": false,
      "default": 42,
      "min": 0,
      "max": 2147483647,
      "description": "Semilla determinista de muestreo."
    },
    "offload": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Descarga secuencial de expertos high/low noise en VRAM."
    },
    "image_asset_id": {
      "type": "string",
      "required": false,
      "default": "",
      "asset_kind": "image",
      "description": "ID del asset de imagen inicial en el proyecto."
    },
    "image_input": {
      "type": "string",
      "required": false,
      "default": "input_reference.png",
      "description": "Nombre del archivo de imagen inicial en ComfyUI input."
    }
  },
  "docs": {
    "uso": "Convierte cualquier fotografía, keyframe extraído o imagen generada con SDXL en un clip de vídeo animado manteniendo la identidad visual del fotograma inicial.",
    "inputs": [
      "prompt (obligatorio): acción del sujeto y movimiento de cámara.",
      "image_asset_id / image_input: imagen de partida subida o generada en el proyecto.",
      "frames (81 por defecto): longitud del clip a 16 fps."
    ],
    "defaults": {
      "resolution": "832x480 (480p 16:9)",
      "frames": 81,
      "steps": 4,
      "cfg": 1.0,
      "lora_lightning_4step": true,
      "offload": true
    },
    "notas_rendimiento": "Emplea las LoRAs LightX2V de 4 pasos para Wan 2.2 14B I2V en fp8_scaled. Nota: las LoRAs Lightning 4-step son exclusivas de los modelos 14B (para la variante ligera TI2V 5B se utiliza LoRA Turbo)."
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      },
      "_meta": {
        "title": "Cargar Wan 2.2 I2V High Noise 14B"
      }
    },
    "2": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      },
      "_meta": {
        "title": "Cargar Wan 2.2 I2V Low Noise 14B"
      }
    },
    "3": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": ["1", 0],
        "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
        "strength_model": 1.0
      },
      "_meta": {
        "title": "LoRA Lightning 4-Step High Noise"
      }
    },
    "4": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": ["2", 0],
        "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
        "strength_model": 1.0
      },
      "_meta": {
        "title": "LoRA Lightning 4-Step Low Noise"
      }
    },
    "5": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan"
      },
      "_meta": {
        "title": "Cargar UMT5 XXL fp8"
      }
    },
    "6": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "clip_vision_h.safetensors"
      },
      "_meta": {
        "title": "Cargar CLIP Vision H"
      }
    },
    "7": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan_2.1_vae.safetensors"
      },
      "_meta": {
        "title": "Cargar Wan VAE"
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image_input}}"
      },
      "_meta": {
        "title": "Cargar Imagen Inicial"
      }
    },
    "9": {
      "class_type": "CLIPVisionEncode",
      "inputs": {
        "clip_vision": ["6", 0],
        "image": ["8", 0],
        "crop": "center"
      },
      "_meta": {
        "title": "Codificar Imagen con CLIP Vision"
      }
    },
    "10": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": ["5", 0]
      },
      "_meta": {
        "title": "Prompt Positivo"
      }
    },
    "11": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative_prompt}}",
        "clip": ["5", 0]
      },
      "_meta": {
        "title": "Prompt Negativo"
      }
    },
    "12": {
      "class_type": "WanImageToVideo",
      "inputs": {
        "positive": ["10", 0],
        "negative": ["11", 0],
        "vae": ["7", 0],
        "clip_vision_output": ["9", 0],
        "start_image": ["8", 0],
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{frames}}",
        "batch_size": 1
      },
      "_meta": {
        "title": "Acondicionamiento Wan Image-to-Video"
      }
    },
    "13": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "add_noise": "enable",
        "noise_seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "start_at_step": 0,
        "end_at_step": 2,
        "return_with_leftover_noise": "enable",
        "offload": "{{offload}}",
        "model": ["3", 0],
        "positive": ["12", 0],
        "negative": ["12", 1],
        "latent_image": ["12", 2]
      },
      "_meta": {
        "title": "Muestreo High-Noise (2 pasos)"
      }
    },
    "14": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "add_noise": "disable",
        "noise_seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "start_at_step": 2,
        "end_at_step": "{{steps}}",
        "return_with_leftover_noise": "disable",
        "offload": "{{offload}}",
        "model": ["4", 0],
        "positive": ["12", 0],
        "negative": ["12", 1],
        "latent_image": ["13", 0]
      },
      "_meta": {
        "title": "Muestreo Low-Noise (2 pasos)"
      }
    },
    "15": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["14", 0],
        "vae": ["7", 0]
      },
      "_meta": {
        "title": "Decodificar Latente"
      }
    },
    "16": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": ["15", 0],
        "frame_rate": 16,
        "loop_count": 0,
        "filename_prefix": "{{output_prefix}}",
        "format": "video/h264-mp4",
        "save_output": true
      },
      "_meta": {
        "title": "Guardar Vídeo en Galería del Proyecto"
      }
    }
  }
}
