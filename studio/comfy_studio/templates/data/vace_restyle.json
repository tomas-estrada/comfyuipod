{
  "id": "vace_restyle",
  "name": "Wan 2.2 VACE 14B — Restyle de Vídeo con Referencia (480p + Offload)",
  "category": "video_edit",
  "output_kind": "video",
  "summary": "Transferencia de estilo e identidad visual sobre un vídeo base mediante el par Wan 2.2 Fun VACE 14B fp8_scaled y referencia CLIP Vision a 480p con offload.",
  "description": "Transforma la estética, iluminación o apariencia de un vídeo existente guiado por un prompt y una imagen de referencia opcional, preservando la dinámica y estructura de movimiento del clip original. Opera por defecto a 480p (832x480) en precisión fp8_scaled con offload entre expertos.",
  "performance_defaults": {
    "precision": "fp8_scaled",
    "resolution": "480p",
    "width": 832,
    "height": 480,
    "frames": 81,
    "steps": 4,
    "cfg": 1.0,
    "strength": 0.85,
    "offload": true,
    "vram_pair_gib": 32.2
  },
  "models": [
    "wan2.2_fun_vace_high_noise_14B_fp8_scaled.safetensors",
    "wan2.2_fun_vace_low_noise_14B_fp8_scaled.safetensors",
    "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
    "clip_vision_h.safetensors",
    "wan_2.1_vae.safetensors"
  ],
  "required_nodes": [
    "UNETLoader",
    "CLIPLoader",
    "CLIPVisionLoader",
    "VAELoader",
    "VHS_LoadVideo",
    "LoadImage",
    "CLIPVisionEncode",
    "CLIPTextEncode",
    "WanVaceToVideo",
    "KSamplerAdvanced",
    "VAEDecode",
    "VHS_VideoCombine"
  ],
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "description": "Descripción del estilo visual, atmósfera o acabado que se desea aplicar al vídeo."
    },
    "negative_prompt": {
      "type": "string",
      "required": false,
      "default": "borroso, baja calidad, parpadeo temporal, artefactos, distorsión",
      "description": "Elementos visuales no deseados a evitar durante el restyle."
    },
    "width": {
      "type": "integer",
      "required": false,
      "default": 832,
      "min": 256,
      "max": 1280,
      "description": "Ancho en píxeles (832 por defecto para 480p 16:9)."
    },
    "height": {
      "type": "integer",
      "required": false,
      "default": 480,
      "min": 256,
      "max": 1280,
      "description": "Alto en píxeles (480 por defecto para ejecución estable en 32 GiB de VRAM)."
    },
    "frames": {
      "type": "integer",
      "required": false,
      "default": 81,
      "min": 1,
      "max": 241,
      "description": "Número de fotogramas a transformar (81 frames ≈ 5 s a 16 fps)."
    },
    "steps": {
      "type": "integer",
      "required": false,
      "default": 4,
      "min": 1,
      "max": 50,
      "description": "Pasos totales de muestreo dividido entre experto high-noise y low-noise."
    },
    "cfg": {
      "type": "number",
      "required": false,
      "default": 1.0,
      "min": 1.0,
      "max": 15.0,
      "description": "Escala de guía CFG."
    },
    "seed": {
      "type": "integer",
      "required": false,
      "default": 42,
      "min": 0,
      "max": 2147483647,
      "description": "Semilla determinista de muestreo."
    },
    "strength": {
      "type": "number",
      "required": false,
      "default": 0.85,
      "min": 0.0,
      "max": 1.0,
      "description": "Intensidad del restyle VACE respecto al vídeo original (0.0 a 1.0)."
    },
    "offload": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Descarga secuencial de expertos en VRAM (activado por defecto)."
    },
    "video_asset_id": {
      "type": "string",
      "required": false,
      "default": "",
      "asset_kind": "video",
      "description": "ID del asset de vídeo de entrada en el proyecto."
    },
    "image_asset_id": {
      "type": "string",
      "required": false,
      "default": "",
      "asset_kind": "image",
      "description": "ID del asset de imagen de referencia estilística o de sujeto en el proyecto."
    },
    "video_input": {
      "type": "string",
      "required": false,
      "default": "input_video.mp4",
      "description": "Archivo de vídeo en ComfyUI input (rellenado automáticamente desde video_asset_id)."
    },
    "image_input": {
      "type": "string",
      "required": false,
      "default": "input_reference.png",
      "description": "Archivo de imagen de referencia en ComfyUI input (rellenado desde image_asset_id)."
    }
  },
  "docs": {
    "uso": "Úsalo para cambiar el estilo artístico, la iluminación o el ambiente completo de un clip de vídeo manteniendo la coreografía, cámara y gestos del metraje original.",
    "inputs": [
      "prompt (obligatorio): descripción del nuevo estilo e iluminación.",
      "video_asset_id / video_input: clip de vídeo original cuyo movimiento se preserva.",
      "image_asset_id / image_input: imagen de referencia opcional para guiar paleta y textura vía CLIP Vision.",
      "strength (0.85 por defecto): equilibra fidelidad estructural frente a libertad estilística."
    ],
    "defaults": {
      "resolution": "832x480 (480p 16:9)",
      "frames": 81,
      "steps": 4,
      "cfg": 1.0,
      "strength": 0.85,
      "offload": true,
      "precision": "fp8_scaled"
    },
    "notas_rendimiento": "Utiliza los pesos Wan 2.2 Fun VACE 14B fp8_scaled (32.2 GiB el par) con resolución 480p y offload de modelos activo por defecto para ejecutarse con holgura en RTX 5090 (32 GB)."
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_fun_vace_high_noise_14B_fp8_scaled.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      },
      "_meta": {
        "title": "Cargar VACE 14B High Noise (fp8)"
      }
    },
    "2": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_fun_vace_low_noise_14B_fp8_scaled.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      },
      "_meta": {
        "title": "Cargar VACE 14B Low Noise (fp8)"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan"
      },
      "_meta": {
        "title": "Cargar UMT5 XXL fp8"
      }
    },
    "4": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "clip_vision_h.safetensors"
      },
      "_meta": {
        "title": "Cargar CLIP Vision H"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan_2.1_vae.safetensors"
      },
      "_meta": {
        "title": "Cargar Wan VAE"
      }
    },
    "6": {
      "class_type": "VHS_LoadVideo",
      "inputs": {
        "video": "{{video_input}}",
        "force_rate": 16,
        "custom_width": "{{width}}",
        "custom_height": "{{height}}",
        "frame_load_cap": "{{frames}}",
        "skip_first_frames": 0,
        "select_every_nth": 1
      },
      "_meta": {
        "title": "Cargar Vídeo Base para Restyle"
      }
    },
    "7": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image_input}}"
      },
      "_meta": {
        "title": "Cargar Imagen de Referencia"
      }
    },
    "8": {
      "class_type": "CLIPVisionEncode",
      "inputs": {
        "clip_vision": ["4", 0],
        "image": ["7", 0],
        "crop": "center"
      },
      "_meta": {
        "title": "Codificar Referencia Visual"
      }
    },
    "9": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": ["3", 0]
      },
      "_meta": {
        "title": "Prompt Positivo"
      }
    },
    "10": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative_prompt}}",
        "clip": ["3", 0]
      },
      "_meta": {
        "title": "Prompt Negativo"
      }
    },
    "11": {
      "class_type": "WanVaceToVideo",
      "inputs": {
        "positive": ["9", 0],
        "negative": ["10", 0],
        "vae": ["5", 0],
        "control_video": ["6", 0],
        "reference_image": ["7", 0],
        "clip_vision_output": ["8", 0],
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{frames}}",
        "batch_size": 1,
        "strength": "{{strength}}"
      },
      "_meta": {
        "title": "Codificación VACE Restyle (480p)"
      }
    },
    "12": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "add_noise": "enable",
        "noise_seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "start_at_step": 0,
        "end_at_step": 2,
        "return_with_leftover_noise": "enable",
        "offload": "{{offload}}",
        "model": ["1", 0],
        "positive": ["11", 0],
        "negative": ["11", 1],
        "latent_image": ["11", 2]
      },
      "_meta": {
        "title": "Muestreo Experto High-Noise (Offload)"
      }
    },
    "13": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "add_noise": "disable",
        "noise_seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "start_at_step": 2,
        "end_at_step": "{{steps}}",
        "return_with_leftover_noise": "disable",
        "offload": "{{offload}}",
        "model": ["2", 0],
        "positive": ["11", 0],
        "negative": ["11", 1],
        "latent_image": ["12", 0]
      },
      "_meta": {
        "title": "Muestreo Experto Low-Noise (Offload)"
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["13", 0],
        "vae": ["5", 0]
      },
      "_meta": {
        "title": "Decodificar Latente a Fotogramas"
      }
    },
    "15": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": ["14", 0],
        "frame_rate": 16,
        "loop_count": 0,
        "filename_prefix": "{{output_prefix}}",
        "format": "video/h264-mp4",
        "save_output": true
      },
      "_meta": {
        "title": "Guardar Vídeo en Galería del Proyecto"
      }
    }
  }
}
