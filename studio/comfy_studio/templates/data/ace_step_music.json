{
  "id": "ace_step_music",
  "name": "ACE-Step 1.5 — Música dirigida",
  "category": "music_generation",
  "output_kind": "audio",
  "summary": "Genera una pista musical desde texto con prompt, letra, tempo y estructura editables.",
  "description": "Usa ACE-Step 1.5 Turbo AIO mediante nodos nativos del ComfyUI fijado. Produce una mezcla musical; no promete stems separados, beat alignment medido ni calidad validada en GPU.",
  "performance_defaults": {
    "precision": "checkpoint AIO Turbo",
    "resolution": "audio",
    "steps": 8,
    "offload": false
  },
  "models": [
    "ace_step_1.5_turbo_aio.safetensors"
  ],
  "required_nodes": [
    "CheckpointLoaderSimple",
    "ModelSamplingAuraFlow",
    "TextEncodeAceStepAudio1.5",
    "EmptyAceStep1.5LatentAudio",
    "KSampler",
    "VAEDecodeAudio",
    "SaveAudioAdvanced"
  ],
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "description": "Descripción musical: género, instrumentos, ánimo y evolución sonora."
    },
    "structure": {
      "type": "string",
      "required": false,
      "default": "hit_loop",
      "choices": ["hit_loop", "build_release", "steady"],
      "description": "Forma musical: golpe y cierre en loop, crescendo con liberación, o energía constante."
    },
    "lyrics": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Letra opcional. Déjala vacía para una pieza instrumental."
    },
    "duration_s": {
      "type": "number",
      "required": false,
      "default": 20.0,
      "min": 1,
      "max": 300,
      "description": "Duración solicitada en segundos, acotada entre 1 y 300."
    },
    "bpm": {
      "type": "integer",
      "required": false,
      "default": 120,
      "min": 20,
      "max": 300,
      "description": "Tempo solicitado en BPM, entre 20 y 300."
    },
    "timesignature": {
      "type": "string",
      "required": false,
      "default": "4",
      "choices": ["2", "3", "4", "6"],
      "description": "Compás admitido por ACE-Step: 2, 3, 4 o 6."
    },
    "language": {
      "type": "string",
      "required": false,
      "default": "en",
      "choices": ["ar", "az", "bg", "bn", "ca", "cs", "da", "de", "el", "en", "es", "fa", "fi", "fr", "he", "hi", "hr", "ht", "hu", "id", "is", "it", "ja", "ko", "la", "lt", "ms", "ne", "nl", "no", "pa", "pl", "pt", "ro", "ru", "sa", "sk", "sr", "sv", "sw", "ta", "te", "th", "tl", "tr", "uk", "ur", "vi", "yue", "zh", "unknown"],
      "description": "Código de idioma para letra y conditioning; español se indica como es."
    },
    "keyscale": {
      "type": "string",
      "required": false,
      "default": "C major",
      "choices": ["C major", "C# major", "Db major", "D major", "D# major", "Eb major", "E major", "F major", "F# major", "Gb major", "G major", "G# major", "Ab major", "A major", "A# major", "Bb major", "B major", "C minor", "C# minor", "Db minor", "D minor", "D# minor", "Eb minor", "E minor", "F minor", "F# minor", "Gb minor", "G minor", "G# minor", "Ab minor", "A minor", "A# minor", "Bb minor", "B minor"],
      "description": "Tonalidad ACE-Step disponible en las opciones del nodo."
    },
    "seed": {
      "type": "integer",
      "required": false,
      "default": 42,
      "min": 0,
      "max": 4294967295,
      "description": "Semilla reproducible para esta ejecución."
    }
  },
  "docs": {
    "uso": "El prompt, la forma solicitada, el BPM, el compás, la tonalidad y la letra se conectan a TextEncodeAceStepAudio1.5. La salida FLAC se valida con ffprobe y se registra en el proyecto.",
    "inputs": [
      "prompt: descripción musical obligatoria.",
      "structure: hit_loop, build_release o steady; dirección textual, no garantía de alineación.",
      "duration_s: 1–300 segundos; 20 segundos por defecto.",
      "bpm: 10–300; el beat map reportado se deriva del tempo pedido, no de detección sobre el audio.",
      "lyrics, language, timesignature, keyscale y seed son controles opcionales."
    ],
    "defaults": {
      "duration_s": 20.0,
      "bpm": 120,
      "timesignature": "4",
      "language": "en",
      "keyscale": "C major",
      "seed": 42,
      "steps": 8
    },
    "notas_rendimiento": "El checkpoint ACE-Step 1.5 Turbo AIO pesa 10,025,478,736 bytes y se adquiere solo con STUDIO_INCLUDE_MUSIC=1. El consumo real de VRAM, el tiempo y la calidad no están medidos en el pod; la validación GPU queda pendiente. No se generan stems separados."
  },
  "workflow": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {"ckpt_name": "ace_step_1.5_turbo_aio.safetensors"},
      "_meta": {"title": "Checkpoint ACE-Step 1.5 Turbo AIO"}
    },
    "2": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {"model": ["1", 0], "shift": 3.0},
      "_meta": {"title": "Sampling ACE-Step"}
    },
    "3": {
      "class_type": "TextEncodeAceStepAudio1.5",
      "inputs": {
        "clip": ["1", 1],
        "tags": "{{structure}}. {{prompt}}",
        "lyrics": "{{lyrics}}",
        "seed": "{{seed}}",
        "bpm": "{{bpm}}",
        "duration": "{{duration_s}}",
        "timesignature": "{{timesignature}}",
        "language": "{{language}}",
        "keyscale": "{{keyscale}}",
        "generate_audio_codes": true,
        "cfg_scale": 2.0,
        "temperature": 0.85,
        "top_p": 0.9,
        "top_k": 0,
        "min_p": 0.0
      },
      "_meta": {"title": "Prompt musical y conditioning dirigido"}
    },
    "4": {
      "class_type": "EmptyAceStep1.5LatentAudio",
      "inputs": {"seconds": "{{duration_s}}", "batch_size": 1},
      "_meta": {"title": "Latente de audio con duración acotada"}
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{seed}}",
        "steps": 8,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": ["2", 0],
        "positive": ["3", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      },
      "_meta": {"title": "ACE-Step Turbo sampler"}
    },
    "6": {
      "class_type": "VAEDecodeAudio",
      "inputs": {"samples": ["5", 0], "vae": ["1", 2]},
      "_meta": {"title": "Decodificar audio generado"}
    },
    "7": {
      "class_type": "SaveAudioAdvanced",
      "inputs": {
        "audio": ["6", 0],
        "filename_prefix": "{{output_prefix}}",
        "format": {"format": "flac"}
      },
      "_meta": {"title": "Guardar FLAC del proyecto"}
    }
  }
}
