#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
  echo "Usage: scripts/opencode-free-builder <task prompt>" >&2
  exit 2
fi

task="$*"
exec python3 "$(dirname "$0")/agent_harness.py" \
  --runtime-id opencode \
  --model-id opencode-go/beam-free \
  --role builder \
  --tools "read,search,edit,write,shell" \
  --task "$task" \
  -- opencode run --agent free-builder '{prompt}'
